---
import { signInUrl, isAppAdmin } from '@/lib/auth';
import { getEnv } from '@/lib/db';
import { analyticsHead } from '@/lib/analytics';
import { displayName } from '@/lib/people';

interface Props {
  title?: string;
  description?: string;
  slate?: { name: string; slug: string };
  // Per-slate context — pages that know the viewer's role and unread-activity
  // count pass them in so the nav can render the Activity icon, the Manage
  // shortcut, and the role line in the Account dropdown without re-querying.
  slateContext?: {
    isMember: boolean;
    isHost: boolean;
    role?: 'member' | 'host' | null;
    unreadActivity?: number;
  };
  // Override the auto-derived OG image URL for non-slate pages.
  ogImage?: string;
  // Override the auto-derived OG description (defaults to `description`).
  ogDescription?: string;
}

const { title = 'Slate', description = 'Coordinate a year of podcast slots across a swarm of hosts.', slate, slateContext, ogImage, ogDescription } = Astro.props;
const user = Astro.locals.user;
const userIsAppAdmin = isAppAdmin(user?.scopes);
const showActivityIcon = !!(slate && slateContext?.isMember);
const showManageBtn = !!(slate && slateContext?.isHost);
const unreadActivity = slateContext?.unreadActivity ?? 0;
const slateRoleLabel = slateContext?.role
  ?? (slateContext?.isHost ? 'host' : slateContext?.isMember ? 'member' : null);

const env = getEnv(Astro);
const url = new URL(Astro.request.url);
const loginHref = signInUrl(env, url.origin, slate ? `/${slate.slug}` : url.pathname);
const analyticsScript = analyticsHead(env);

// When viewing a slate-scoped page, the brand block becomes the slate name
// and links to the slate's public root rather than the app landing.
const brandHref = slate ? `/${slate.slug}` : '/';
const brandLabel = slate ? slate.name : 'slate';

// OG card defaults. Slate pages get a per-slate generated SVG card with an
// invitation to join + topic-pool stats. Non-slate pages get a generic
// fallback unless `ogImage` is overridden.
const canonicalUrl = url.toString();
const computedOgImage = ogImage ?? (slate ? `${url.origin}/og/${slate.slug}.svg` : `${url.origin}/og/landing.svg`);
const ogTitle = slate ? `Join ${slate.name} on Slate` : title;
const computedOgDescription = ogDescription ?? (slate
  ? `Members suggest topics. Everyone upvotes. Hosts pick what to record. Sign up free.`
  : description);
---

<!doctype html>
<html lang="en" data-theme="slate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Slate" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={computedOgDescription} />
    <meta property="og:image" content={computedOgImage} />
    {computedOgImage.endsWith('.svg') && <meta property="og:image:type" content="image/svg+xml" />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={computedOgDescription} />
    <meta name="twitter:image" content={computedOgImage} />

    <Fragment set:html={analyticsScript} />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content font-sans antialiased">
    <header class="border-b border-base-300">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <a href={brandHref} class="block min-w-0 no-underline" title={brandLabel}>
          <div class="text-signal text-base md:text-lg font-bold tracking-tight leading-tight truncate font-mono">{brandLabel}</div>
          <div class="opacity-40 text-[10px] md:text-xs leading-tight font-mono hidden sm:block">// slate.ljs.app</div>
        </a>

        <nav class="text-sm flex items-center gap-1 sm:gap-2 shrink-0">
          {showActivityIcon && (
            <a
              href={`/${slate!.slug}/activity`}
              class="relative inline-flex items-center justify-center w-9 h-9 rounded hover:bg-base-200 transition-colors"
              aria-label={unreadActivity > 0 ? `Activity (${unreadActivity} unread)` : 'Activity'}
              title="Activity"
            >
              <svg class="w-5 h-5 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
              {unreadActivity > 0 && (
                <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-signal text-[10px] font-bold text-white inline-flex items-center justify-center">
                  {unreadActivity > 9 ? '9+' : unreadActivity}
                </span>
              )}
            </a>
          )}
          {slate && (slateContext?.isMember || slateContext?.isHost) && (
            <a href={`/${slate.slug}/edit`} class="px-3 py-1.5 rounded text-sm hover:bg-base-200 hover:text-signal transition-colors">
              Manage
            </a>
          )}
          {user ? (
            <details id="account-menu" class="dropdown dropdown-end">
              <summary class="cursor-pointer inline-flex items-center gap-1 px-3 py-1.5 rounded hover:bg-base-200 hover:text-signal transition-colors list-none [&::-webkit-details-marker]:hidden">
                Account
                <svg viewBox="0 0 12 12" class="w-2.5 h-2.5 opacity-60" fill="currentColor" aria-hidden="true">
                  <path d="M6 9L1 4h10z"/>
                </svg>
              </summary>
              <ul class="dropdown-content z-10 mt-2 w-72 bg-base-100 border border-base-300 rounded shadow-sm py-1 text-sm">
                <li class="px-3 py-2 border-b border-base-300">
                  <div class="font-semibold truncate">{displayName(user)}</div>
                  <div class="font-mono text-xs opacity-50 truncate mt-0.5">{user.email}</div>
                  {slate && slateRoleLabel && (
                    <div class="text-xs opacity-70 mt-1.5">
                      <span class="font-medium">{slateRoleLabel}</span>
                      <span class="opacity-60"> · {slate.name}</span>
                    </div>
                  )}
                </li>
                <li>
                  <a href="/me" class="block px-3 py-2 hover:bg-base-200 hover:text-signal transition-colors">My slates</a>
                </li>
                {userIsAppAdmin && (
                  <li>
                    <a href="/admin" class="block px-3 py-2 hover:bg-base-200 hover:text-signal transition-colors">Admin</a>
                  </li>
                )}
                <li>
                  <a href="/me#profile" class="block px-3 py-2 hover:bg-base-200 hover:text-signal transition-colors">Edit profile</a>
                </li>
                <li class="border-t border-base-300 mt-1 pt-1">
                  <form method="POST" action="/api/auth/sign-out" class="contents">
                    <button type="submit" class="block w-full text-left px-3 py-2 hover:bg-base-200 hover:text-signal transition-colors">
                      Sign out
                    </button>
                  </form>
                </li>
              </ul>
            </details>
          ) : (
            <a href={loginHref} class="px-3 py-1.5 rounded hover:bg-base-200 hover:text-signal transition-colors">Sign In / Sign Up</a>
          )}
        </nav>
      </div>
    </header>

    <script is:inline>
      // Close the Account dropdown when the user clicks outside it. Native
      // <details> stays open after a click on a menu item, so for in-page
      // links (Edit profile anchors, etc.) we'd otherwise leave it hanging.
      (() => {
        const menu = document.getElementById('account-menu');
        if (!menu) return;
        document.addEventListener('click', (e) => {
          if (!menu.open) return;
          if (!menu.contains(e.target)) menu.open = false;
        });
        menu.querySelectorAll('a, button').forEach((el) => {
          el.addEventListener('click', () => { menu.open = false; });
        });
      })();
    </script>
    <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>
    <footer class="border-t border-base-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-4 text-xs opacity-60 font-mono flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span>slate — beta. free for now.</span>
        <span class="opacity-50">·</span>
        <a href="/terms" class="hover:opacity-100">Terms</a>
        <a href="/privacy" class="hover:opacity-100">Privacy</a>
        <span class="ml-auto opacity-50">made by <a href="https://askscottpierce.com" target="_blank" rel="noopener" class="hover:opacity-100">Scott Pierce</a> · <span>Left Join Studio</span></span>
      </div>
    </footer>
  </body>
</html>
