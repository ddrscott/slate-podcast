---
import { signInUrl } from '@/lib/auth';
import { getEnv } from '@/lib/db';
import { analyticsHead } from '@/lib/analytics';

interface Props {
  title?: string;
  description?: string;
  slate?: { name: string; slug: string };
  // Override the auto-derived OG image URL for non-slate pages.
  ogImage?: string;
  // Override the auto-derived OG description (defaults to `description`).
  ogDescription?: string;
}

const { title = 'Slate', description = 'Coordinate a year of podcast slots across a swarm of speakers.', slate, ogImage, ogDescription } = Astro.props;
const user = Astro.locals.user;

const env = getEnv(Astro);
const url = new URL(Astro.request.url);
const loginHref = signInUrl(env, url.origin, slate ? `/${slate.slug}` : url.pathname);
const analyticsScript = analyticsHead(env);

// When viewing a slate-scoped page, the brand block becomes the slate name
// and links to the slate's public root rather than the app landing.
const brandHref = slate ? `/${slate.slug}` : '/';
const brandLabel = slate ? slate.name : 'slate';

// OG card defaults. Slate pages get a per-slate generated SVG card with an
// invitation to join + suggestion-pool stats. Non-slate pages get a generic
// fallback unless `ogImage` is overridden.
const canonicalUrl = url.toString();
const computedOgImage = ogImage ?? (slate ? `${url.origin}/og/${slate.slug}.svg` : `${url.origin}/og/landing.svg`);
const ogTitle = slate ? `Join ${slate.name} on Slate` : title;
const computedOgDescription = ogDescription ?? (slate
  ? `Members suggest topics. Everyone upvotes. Speakers pick what to record. Sign up free.`
  : description);
---

<!doctype html>
<html lang="en" data-theme="slate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Slate" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={computedOgDescription} />
    <meta property="og:image" content={computedOgImage} />
    {computedOgImage.endsWith('.svg') && <meta property="og:image:type" content="image/svg+xml" />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={computedOgDescription} />
    <meta name="twitter:image" content={computedOgImage} />

    <Fragment set:html={analyticsScript} />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content font-sans antialiased">
    <header class="border-b border-base-300">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <a href={brandHref} class="font-mono text-base md:text-lg font-bold tracking-tight no-underline truncate min-w-0">
          <span class="text-signal">{brandLabel}</span><span class="opacity-50 hidden sm:inline"> // slate.ljs.app</span>
        </a>

        {/* Desktop: inline nav (md+) */}
        <nav class="text-sm space-x-4 opacity-75 hidden md:flex items-center">
          {user ? (
            <>
              <a href="/me" class="hover:opacity-100">My slates</a>
              <a href="/admin" class="hover:opacity-100">Admin</a>
              <span class="opacity-40">·</span>
              <span class="font-mono text-xs opacity-60">{user.email}</span>
              <form method="POST" action="/api/auth/sign-out" class="inline">
                <button type="submit" class="hover:opacity-100 underline-offset-2 hover:underline">sign out</button>
              </form>
            </>
          ) : (
            <a href={loginHref} class="hover:opacity-100">Sign In / Sign Up</a>
          )}
        </nav>

        {/* Mobile: hamburger toggle (<md) */}
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          class="md:hidden btn btn-ghost btn-square min-h-11 h-11 w-11 -mr-2"
        >
          <svg class="w-5 h-5 nav-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-5 h-5 nav-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12M6 18L18 6"/>
          </svg>
        </button>
      </div>

      {/* Mobile dropdown panel (<md) */}
      <nav id="mobile-nav-panel" hidden class="md:hidden border-t border-base-300 bg-base-100">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1 text-sm">
          {user ? (
            <>
              <a href="/me" class="block py-2 hover:text-signal">My slates</a>
              <a href="/admin" class="block py-2 hover:text-signal">Admin</a>
              <div class="py-2 font-mono text-xs opacity-60 border-t border-base-300 mt-1">{user.email}</div>
              <form method="POST" action="/api/auth/sign-out">
                <button type="submit" class="block w-full text-left py-2 hover:text-signal underline-offset-2 hover:underline">Sign out</button>
              </form>
            </>
          ) : (
            <a href={loginHref} class="block py-2 hover:text-signal">Sign In / Sign Up</a>
          )}
        </div>
      </nav>
    </header>

    <script is:inline>
      (() => {
        const btn = document.getElementById('mobile-nav-toggle');
        const panel = document.getElementById('mobile-nav-panel');
        if (!btn || !panel) return;
        const iconOpen = btn.querySelector('.nav-icon-open');
        const iconClose = btn.querySelector('.nav-icon-close');
        btn.addEventListener('click', () => {
          const opening = panel.hasAttribute('hidden');
          if (opening) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', String(opening));
          iconOpen?.classList.toggle('hidden', opening);
          iconClose?.classList.toggle('hidden', !opening);
        });
      })();
    </script>
    <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>
    <footer class="border-t border-base-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-4 text-xs opacity-60 font-mono flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span>slate — beta. free for now.</span>
        <span class="opacity-50">·</span>
        <a href="/terms" class="hover:opacity-100">Terms</a>
        <a href="/privacy" class="hover:opacity-100">Privacy</a>
        <span class="ml-auto opacity-50">made by <a href="https://askscottpierce.com" target="_blank" rel="noopener" class="hover:opacity-100">Scott Pierce</a> · <span>Left Join Studio</span></span>
      </div>
    </footer>
  </body>
</html>
