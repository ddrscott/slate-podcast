---
// Renders a horizontal row of distribution-channel links on the marquee.
// Filters to non-null URLs only. If all four channels are null, the
// component renders nothing (no empty row, no header).

interface Props {
  apple: string | null;
  spotify: string | null;
  youtube: string | null;
  rss: string | null;
}

const { apple, spotify, youtube, rss } = Astro.props;

const links: Array<{ key: string; href: string; label: string }> = [];
if (apple)   links.push({ key: 'apple',   href: apple,   label: 'Apple Podcasts' });
if (spotify) links.push({ key: 'spotify', href: spotify, label: 'Spotify' });
if (youtube) links.push({ key: 'youtube', href: youtube, label: 'YouTube' });
if (rss)     links.push({ key: 'rss',     href: rss,     label: 'RSS' });
---

{links.length > 0 && (
  <div class="mt-6 flex flex-wrap items-center gap-2">
    <span class="font-mono text-xs text-signal mr-1">// listen on</span>
    {links.map(l => (
      <a href={l.href} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded border border-base-300 hover:border-signal hover:text-signal text-xs font-mono transition-colors"
         aria-label={`Listen on ${l.label}`}>
        {l.key === 'apple' && (
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-.5 16.7c-2.6 0-4.7-2.1-4.7-4.7v-3.7c0-.4.3-.7.7-.7s.7.3.7.7V14c0 1.8 1.4 3.2 3.2 3.2.4 0 .7.3.7.7s-.2.8-.6.8zm0-2.7c-1 0-1.9-.8-1.9-1.9V11c0-.4.3-.7.7-.7s.7.3.7.7v3.1c0 .3.2.5.5.5s.5-.2.5-.5V8.5c0-.4.3-.7.7-.7s.7.3.7.7v5.6c0 1-.8 1.9-1.9 1.9zm5.2-2c0 .4-.3.7-.7.7s-.7-.3-.7-.7V8c0-.4.3-.7.7-.7s.7.3.7.7v6z"/>
          </svg>
        )}
        {l.key === 'spotify' && (
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.6 14.4c-.2.3-.6.4-.9.2-2.4-1.5-5.5-1.8-9.1-1-.4.1-.7-.2-.8-.5-.1-.4.1-.7.5-.8 4-.9 7.4-.5 10.1 1.1.3.2.4.6.2 1zm1.2-2.7c-.2.4-.7.5-1.1.3-2.8-1.7-7-2.2-10.3-1.2-.4.1-.9-.1-1-.5-.1-.4.1-.9.5-1 3.8-1.1 8.4-.6 11.6 1.3.3.2.5.7.3 1.1zm.1-2.8c-3.3-2-8.8-2.1-12-1.2-.5.2-1-.1-1.2-.6-.2-.5.1-1 .6-1.2 3.7-1.1 9.7-.9 13.5 1.4.5.3.6.9.3 1.4-.3.4-.9.5-1.2.2z"/>
          </svg>
        )}
        {l.key === 'youtube' && (
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2c-.3-1-1.1-1.8-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6c-1 .3-1.8 1.1-2.1 2.1C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1 1.1 1.8 2.1 2.1 1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6c1-.3 1.8-1.1 2.1-2.1.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>
          </svg>
        )}
        {l.key === 'rss' && (
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.5 17.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4zM4 11V8c5 0 9 4 9 9h-3a6 6 0 0 0-6-6zm0-7V1c11.6 0 21 9.4 21 21h-3C22 11.5 13.5 4 4 4z"/>
          </svg>
        )}
        <span>{l.label}</span>
      </a>
    ))}
  </div>
)}
