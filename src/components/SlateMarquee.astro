---
// Public landing page for a slate. Shown to visitors and signed-in
// non-members; current Members and Hosts get the management view in
// [slate]/index.astro instead.
//
// Direction A — Network Marquee. The slate is framed as a network of
// hosts; the page sells the program emotionally before the form layer
// (vote / suggest / claim) shows up after sign-in.

import { displayName, emailLocal } from '@/lib/people';
import ListenOnRow from '@/components/ListenOnRow.astro';

interface Host {
  id: string;
  display_name: string | null;
  email: string;
  headshot_url: string | null;
  tagline: string | null;
  bio: string | null;
  link: string | null;
  episode_count: number;
}

interface UpcomingSlot {
  id: string;
  start_time: number;
  title: string | null;
  topic_id: string | null;
  promo_image_url: string | null;
  host_display_name: string | null;
  host_email: string | null;
  host_headshot_url: string | null;
}

interface TopTopic {
  id: string;
  title: string;
  upvote_count: number;
}

interface PastEpisode {
  id: string;
  start_time: number;
  title: string | null;
  host_display_name: string | null;
  host_email: string | null;
}

export interface MarqueeSlate {
  id: string;
  slug: string;
  name: string;
  description: string | null;
  timezone: string;
  cover_image_url: string | null;
  artwork_image_url: string | null;
  marquee_accent: string | null;
  listen_apple_url: string | null;
  listen_spotify_url: string | null;
  listen_youtube_url: string | null;
  listen_rss_url: string | null;
}

interface Props {
  slate: MarqueeSlate;
  hosts: Host[];
  upcoming: UpcomingSlot[];
  topTopics: TopTopic[];
  pastEpisodes: PastEpisode[];
  signInHref: string;
  isSignedIn: boolean;
  isMember: boolean;
  isHost: boolean;
}

const { slate, hosts, upcoming, topTopics, pastEpisodes, signInHref, isSignedIn, isMember, isHost } = Astro.props;

const fmtUpcoming = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
});
const fmtUpcomingTime = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, hour: 'numeric', minute: '2-digit',
});
const fmtPast = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, month: 'short', day: 'numeric', year: 'numeric',
});

const initials = (h: { display_name: string | null; email: string }) =>
  displayName({ display_name: h.display_name, email: h.email }).charAt(0).toUpperCase();

const hostName = (h: { display_name: string | null; email: string }) =>
  displayName({ display_name: h.display_name, email: h.email });

const hostNameOrFallback = (display: string | null, email: string | null) =>
  email ? displayName({ display_name: display, email }) : '(unassigned)';

const hostCount = hosts.length;
const topicCount = topTopics.length;
const episodeCount = pastEpisodes.length;

// Eyebrow line above the hero title. Drops the host count when there are
// no hosts yet (a brand-new slate) so we don't print "// a network of
// 0 hosts" — the slate is fine, it just hasn't promoted anyone yet.
const tzShort = slate.timezone.split('/').pop()?.replace('_', ' ');
const eyebrowText = hostCount === 0
  ? `// a new slate · ${tzShort}`
  : `// a network of ${hostCount === 1 ? 'one host' : `${hostCount} hosts`} · ${tzShort}`;

// Primary CTA depends on viewer relationship to the slate:
//   visitor          → sign in (and come back here)
//   signed-in viewer → join as a member
//   member / host    → open the dashboard (where voting + scheduling lives)
let primaryCtaLabel: string;
let primaryCtaHref: string;
if (isMember || isHost) {
  primaryCtaLabel = 'Open dashboard →';
  primaryCtaHref  = `/${slate.slug}/edit`;
} else if (isSignedIn) {
  primaryCtaLabel = 'Join as a Member';
  primaryCtaHref  = `/${slate.slug}/join`;
} else {
  primaryCtaLabel = 'Sign in to vote';
  primaryCtaHref  = signInHref;
}
---

<article class="-mt-8" data-marquee-theme
         style={slate.marquee_accent ? `--ms-accent: ${slate.marquee_accent};` : undefined}>
  {/* ─── Hero ────────────────────────────────────────────────────────── */}
  {/* Banner image (cover_image_url) renders as a blurred backdrop. Square
      artwork (artwork_image_url) renders as the centerpiece. Either is
      optional — null fallbacks mirror today's typographic header. */}
  <section class="relative -mx-4 px-4 py-12 md:py-20 overflow-hidden border-b border-base-300">
    {slate.cover_image_url && (
      <div class="absolute inset-0 -z-10">
        <img src={slate.cover_image_url} alt=""
             class="w-full h-full object-cover opacity-30 blur-xl scale-110" />
        <div class="absolute inset-0 bg-gradient-to-b from-base-100/70 via-base-100/85 to-base-100"></div>
      </div>
    )}
    {!slate.cover_image_url && (
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-signal/5 via-base-100 to-base-100"></div>
    )}

    <div class={`grid gap-8 md:gap-12 items-center max-w-5xl ${slate.artwork_image_url ? 'md:grid-cols-[auto,1fr]' : ''}`}>
      {slate.artwork_image_url && (
        <img src={slate.artwork_image_url} alt={`${slate.name} artwork`}
             class="w-44 sm:w-56 md:w-64 lg:w-72 aspect-square object-cover rounded-lg shadow-2xl border border-base-300 mx-auto md:mx-0" />
      )}
      <div class="min-w-0">
        <p class="font-mono text-xs md:text-sm text-signal mb-4">{eyebrowText}</p>
        <h1 class={slate.artwork_image_url
            ? "text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[0.95]"
            : "text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[0.95]"}>
          {slate.name}
        </h1>
        {slate.description && (
          <p class="mt-6 text-lg md:text-xl opacity-80 max-w-2xl leading-relaxed">
            {slate.description}
          </p>
        )}
        <div class="mt-6 inline-block w-12 h-[3px] bg-signal"></div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={primaryCtaHref} class="btn btn-primary">{primaryCtaLabel}</a>
          {topicCount > 0 && (
            <a href="#topics" class="btn btn-ghost border border-base-300">
              Browse {topicCount} {topicCount === 1 ? 'topic' : 'topics'} →
            </a>
          )}
          {!isSignedIn && (
            <span class="text-xs opacity-60 font-mono ml-2">free · email magic-link</span>
          )}
        </div>
        <ListenOnRow
          apple={slate.listen_apple_url}
          spotify={slate.listen_spotify_url}
          youtube={slate.listen_youtube_url}
          rss={slate.listen_rss_url}
        />
      </div>
    </div>
  </section>

  {/* ─── Up next ─────────────────────────────────────────────────────── */}
  {/* Lead section. A listener landing here should see the very next show
      immediately. First slot is rendered as a featured card (big art,
      big date/time, host byline); remaining slots tile below. */}
  {upcoming.length > 0 && (
    <section class="py-12 md:py-16">
      <header class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          <span class="font-mono text-signal text-xs md:text-sm align-middle">// </span>
          Up next
        </h2>
        <span class="font-mono text-xs opacity-50">{slate.timezone}</span>
      </header>

      {/* Lead card — the very next show. */}
      {(() => {
        const s = upcoming[0];
        const date = new Date(s.start_time * 1000);
        const dateStr = fmtUpcoming.format(date);
        const timeStr = fmtUpcomingTime.format(date);
        const hostLabel = s.host_email ? hostNameOrFallback(s.host_display_name, s.host_email) : null;
        const tileArt = s.promo_image_url ?? slate.artwork_image_url;
        const href = s.topic_id ? `/${slate.slug}/topics/${s.topic_id}` : `/${slate.slug}/slot/${s.id}`;
        return (
          <a href={href}
             class="group block rounded-lg border border-base-300 hover:border-signal transition-colors overflow-hidden">
            <div class="grid md:grid-cols-[minmax(0,1fr)_2fr] gap-0">
              {tileArt ? (
                <div class="aspect-square md:aspect-auto overflow-hidden bg-base-200 border-b md:border-b-0 md:border-r border-base-300">
                  <img src={tileArt} alt="" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500" />
                </div>
              ) : (
                <div class="hidden md:block bg-gradient-to-br from-signal/10 to-base-200 border-r border-base-300"></div>
              )}
              <div class="p-6 md:p-8 flex flex-col justify-center">
                <div class="flex items-baseline gap-3 font-mono text-sm">
                  <span class="text-signal font-bold">{dateStr}</span>
                  <span class="opacity-50">·</span>
                  <span class="opacity-70">{timeStr}</span>
                </div>
                <h3 class="mt-3 text-2xl md:text-3xl font-bold leading-tight line-clamp-3">
                  {s.title ?? <span class="opacity-50 italic font-normal">No topic yet — check back soon</span>}
                </h3>
                {hostLabel && (
                  <div class="mt-4 flex items-center gap-2 text-sm">
                    {s.host_headshot_url ? (
                      <img src={s.host_headshot_url} alt="" class="w-7 h-7 rounded-full object-cover" />
                    ) : (
                      <span class="w-7 h-7 rounded-full bg-base-200 border border-base-300 flex items-center justify-center font-mono text-xs opacity-60">
                        {hostLabel.charAt(0).toUpperCase()}
                      </span>
                    )}
                    <span class="opacity-80">with <span class="font-semibold">{hostLabel}</span></span>
                  </div>
                )}
                <p class="mt-5 font-mono text-xs text-signal opacity-0 group-hover:opacity-100 transition-opacity">
                  Read more →
                </p>
              </div>
            </div>
          </a>
        );
      })()}

      {/* Remaining upcoming slots — secondary grid. */}
      {upcoming.length > 1 && (
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
          {upcoming.slice(1).map(s => {
            const date = new Date(s.start_time * 1000);
            const dateStr = fmtUpcoming.format(date);
            const timeStr = fmtUpcomingTime.format(date);
            const hostLabel = s.host_email ? hostNameOrFallback(s.host_display_name, s.host_email) : null;
            const tileArt = s.promo_image_url ?? slate.artwork_image_url;
            const href = s.topic_id ? `/${slate.slug}/topics/${s.topic_id}` : `/${slate.slug}/slot/${s.id}`;
            return (
              <li>
                <a href={href}
                   class="block rounded border border-base-300 hover:border-signal transition-colors h-full overflow-hidden">
                  {tileArt && (
                    <div class="aspect-square overflow-hidden border-b border-base-300 bg-base-200">
                      <img src={tileArt} alt="" class="w-full h-full object-cover" />
                    </div>
                  )}
                  <div class="p-5">
                    <div class="flex items-baseline justify-between font-mono text-xs">
                      <span class="text-signal">{dateStr}</span>
                      <span class="opacity-60">{timeStr}</span>
                    </div>
                    <div class="mt-3 font-semibold leading-snug line-clamp-3">
                      {s.title ?? <span class="opacity-50 italic font-normal">No topic yet</span>}
                    </div>
                    {hostLabel && (
                      <div class="mt-3 flex items-center gap-2 text-xs">
                        {s.host_headshot_url ? (
                          <img src={s.host_headshot_url} alt="" class="w-5 h-5 rounded-full object-cover" />
                        ) : (
                          <span class="w-5 h-5 rounded-full bg-base-200 border border-base-300 flex items-center justify-center font-mono text-[10px] opacity-60">
                            {hostLabel.charAt(0).toUpperCase()}
                          </span>
                        )}
                        <span class="opacity-70 truncate">{hostLabel}</span>
                      </div>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  )}

  {/* ─── Hosts rail ──────────────────────────────────────────────────── */}
  {hosts.length > 0 && (
    <section class="py-12 md:py-16 border-t border-base-300">
      <header class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          <span class="font-mono text-signal text-xs md:text-sm align-middle">// </span>
          The hosts
        </h2>
        <span class="font-mono text-xs opacity-50">
          {hostCount} {hostCount === 1 ? 'host' : 'hosts'}
        </span>
      </header>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {hosts.map(h => (
          <li class="group flex gap-4 p-4 rounded border border-base-300 hover:border-signal transition-colors">
            <div class="shrink-0">
              {h.headshot_url ? (
                <img src={h.headshot_url} alt=""
                     class="w-16 h-16 rounded-full object-cover border border-base-300" />
              ) : (
                <div class="w-16 h-16 rounded-full bg-base-200 border border-base-300 flex items-center justify-center text-2xl font-mono opacity-60">
                  {initials(h)}
                </div>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2">
                <span class="font-bold truncate">{hostName(h)}</span>
                {h.episode_count > 0 && (
                  <span class="font-mono text-xs opacity-50 shrink-0">{h.episode_count} ep</span>
                )}
              </div>
              {h.tagline && (
                <p class="text-xs opacity-70 mt-0.5 line-clamp-1">{h.tagline}</p>
              )}
              {h.bio && (
                <p class="text-sm opacity-80 mt-2 line-clamp-3 leading-snug">{h.bio}</p>
              )}
              {h.link && (
                <a href={h.link} target="_blank" rel="noopener noreferrer"
                   class="inline-block mt-2 text-xs font-mono text-signal hover:underline truncate max-w-full">
                  ↗ {h.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ─── Topic Pool ───────────────────────────────────────────────────── */}
  {/* Unscheduled, voteable topics. Anything already attached to an
      upcoming slot belongs in "Up next" instead; this list filters it
      out at query time so the marquee can't double-show a topic. */}
  {topTopics.length > 0 && (
    <section id="topics" class="py-12 md:py-16 border-t border-base-300">
      <header class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          <span class="font-mono text-signal text-xs md:text-sm align-middle">// </span>
          Topic Pool
        </h2>
        <a href={`/${slate.slug}/topics`} class="text-sm opacity-70 hover:text-signal hover:opacity-100">
          See all →
        </a>
      </header>
      <ol class="space-y-1 max-w-3xl">
        {topTopics.map((t, i) => (
          <li>
            <a href={`/${slate.slug}/topics/${t.id}`}
               class="group flex items-baseline gap-4 py-3 border-b border-base-300/50 last:border-b-0 -mx-2 px-2 rounded hover:bg-base-200/40 transition-colors">
              <span class="font-mono text-xs opacity-40 w-6 shrink-0 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-mono text-sm text-signal w-12 shrink-0 tabular-nums">
                ★ {t.upvote_count}
              </span>
              <span class="flex-1 truncate group-hover:text-signal transition-colors">{t.title}</span>
              <span class="font-mono text-xs opacity-0 group-hover:opacity-60 transition-opacity shrink-0">
                read →
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm opacity-70">
        {(isMember || isHost) ? (
          <>
            <a href={`/${slate.slug}/edit`} class="link link-hover text-signal">Open the dashboard</a> to vote and post your own.
          </>
        ) : isSignedIn ? (
          <>
            <a href={`/${slate.slug}/join`} class="link link-hover text-signal">Join as a Member</a> to vote and post your own.
          </>
        ) : (
          <>
            <a href={signInHref} class="link link-hover text-signal">Sign in</a> to vote on these or post your own.
          </>
        )}
      </p>
    </section>
  )}

  {/* ─── Past episodes ───────────────────────────────────────────────── */}
  {pastEpisodes.length > 0 && (
    <section class="py-12 md:py-16 border-t border-base-300">
      <header class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          <span class="font-mono text-signal text-xs md:text-sm align-middle">// </span>
          Past episodes
        </h2>
        <span class="font-mono text-xs opacity-50">
          {episodeCount} {episodeCount === 1 ? 'episode' : 'episodes'}
        </span>
      </header>
      <ul class="divide-y divide-base-300/50 max-w-3xl">
        {pastEpisodes.map(e => {
          const dateStr = fmtPast.format(new Date(e.start_time * 1000));
          const hostLabel = e.host_email ? hostNameOrFallback(e.host_display_name, e.host_email) : null;
          return (
            <li>
              <a href={`/${slate.slug}/slot/${e.id}`}
                 class="block py-3 hover:bg-base-200/40 -mx-2 px-2 rounded transition-colors">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-xs opacity-60 w-24 shrink-0 tabular-nums">{dateStr}</span>
                  <span class="font-medium flex-1 min-w-0 truncate">
                    {e.title ?? <span class="opacity-50 italic font-normal">Untitled</span>}
                  </span>
                  {hostLabel && (
                    <span class="font-mono text-xs opacity-60 shrink-0">{hostLabel}</span>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {/* ─── Empty state if nothing yet ──────────────────────────────────── */}
  {hosts.length === 0 && upcoming.length === 0 && topTopics.length === 0 && pastEpisodes.length === 0 && (
    <section class="py-20 text-center max-w-2xl mx-auto">
      <p class="font-mono text-sm text-signal mb-2">// new slate</p>
      <h2 class="text-2xl font-bold">Nothing here yet.</h2>
      <p class="mt-3 opacity-70">
        Hosts haven't been promoted, no topics in the pool, no episodes scheduled.
        Check back soon, or <a href={primaryCtaHref} class="link link-hover text-signal">{primaryCtaLabel.toLowerCase()}</a>.
      </p>
    </section>
  )}

  {/* ─── Closing CTA ─────────────────────────────────────────────────── */}
  {(hosts.length > 0 || upcoming.length > 0 || topTopics.length > 0 || pastEpisodes.length > 0) && (
    <section class="py-16 border-t border-base-300 text-center">
      <p class="font-mono text-xs text-signal mb-2">// join the show</p>
      <p class="text-lg md:text-xl font-bold max-w-xl mx-auto leading-snug">
        Members suggest topics. Everyone upvotes. Hosts pick what to record.
      </p>
      <a href={primaryCtaHref} class="btn btn-primary mt-6">{primaryCtaLabel}</a>
    </section>
  )}
</article>
