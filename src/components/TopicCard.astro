---
// Card representation of a topic. Used on the slate index "Top topic
// topics" section and the full /[slate]/topics list. State is
// encoded by treatment, not by a label badge:
//   - open      → white card, full-weight title, primary action button
//   - scheduled → muted base-200 card, deemphasized title, scheduled time inline,
//                 small unschedule control if the viewer owns the slot
//   - archived  → dashed border, fully muted

import { displayName } from '@/lib/people';

export interface CardTopic {
  id: string;
  title: string;
  description: string | null;
  url: string | null;
  upvote_count: number;
  // Comment count excludes soft-deleted nodes — they show as
  // "[deleted]" in the thread but shouldn't inflate the activity signal.
  comment_count?: number;
  status: string;                          // 'open' | 'scheduled' | 'archived'
  has_voted: number | null;
  scheduled_slot_id: string | null;
  scheduled_start: number | null;
  scheduled_host_id: string | null;
  scheduled_host_email: string | null;
  scheduled_host_display_name?: string | null;
  author_email?: string | null;
  author_display_name?: string | null;
  tags?: string | null;
}

interface Props {
  s: CardTopic;
  // Slate slug — feeds the card's data-href for click-through to the
  // topic detail page (/[slate]/topics/[id]).
  slateSlug: string;
  isMember: boolean;
  isHost: boolean;
  currentUserId: string | undefined;
  isAdmin: boolean;
  fmtSched: Intl.DateTimeFormat;
  showAuthor?: boolean;
  showTags?: boolean;
}

const {
  s, slateSlug, isMember, isHost, currentUserId, isAdmin, fmtSched,
  showAuthor = false, showTags = false,
} = Astro.props;

const isOpen = s.status === 'open';
const isScheduled = s.status === 'scheduled';
const isArchived = s.status === 'archived';
const canUnschedule = isScheduled && !!s.scheduled_slot_id &&
  (s.scheduled_host_id === currentUserId || isAdmin);

const cardBg = isScheduled ? 'bg-base-200/40' : 'bg-base-100';
const cardBorder = s.has_voted
  ? 'border-signal'
  : isArchived
    ? 'border-base-300 border-dashed'
    : 'border-base-300';
const titleClass = isOpen ? '' : 'opacity-70';

const tagList = s.tags ? s.tags.split(',').map(t => t.trim()).filter(Boolean) : [];
const hasMeta = (showAuthor && s.author_email) ||
  (showTags && tagList.length > 0) ||
  (isScheduled && s.scheduled_start) ||
  !!s.url;
const hasActions = (isHost && isOpen) || canUnschedule;

const detailHref = `/${slateSlug}/topics/${s.id}`;
const shortUrl = s.url
  ? s.url.replace(/^https?:\/\//, '').replace(/\/$/, '')
  : null;

const hostName = displayName({
  display_name: s.scheduled_host_display_name ?? null,
  email: s.scheduled_host_email,
});
const authorName = displayName({
  display_name: s.author_display_name ?? null,
  email: s.author_email,
});
---

<article
  data-topic-card={s.id}
  data-topic-status={s.status}
  data-topic-title={s.title}
  data-href={detailHref}
  class={`topic-card rounded border ${cardBorder} ${cardBg} transition-colors cursor-pointer hover:border-base-content/30`}
  role="link"
  tabindex="0"
  aria-label={`Open details for ${s.title}`}
>
  <div class="flex items-stretch gap-2 p-3">
    {/* Left rail: upvote (top) + comment count (bottom). Paired
        visually so the "activity" signal — votes AND discussion —
        is the first thing the eye lands on. */}
    <div class="shrink-0 w-12 flex flex-col items-center">
      {isMember ? (
        <button
          class="upvote w-12 min-h-[48px] flex flex-col items-center justify-center rounded hover:bg-base-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal focus-visible:ring-offset-1 transition-colors"
          data-id={s.id}
          aria-label={`Upvote (currently ${s.upvote_count})`}
        >
          <span data-vote-arrow class={`text-base leading-none ${s.has_voted ? 'text-signal' : 'opacity-40'}`}>▲</span>
          <span data-vote-count class={`font-mono text-xs leading-tight mt-0.5 ${s.has_voted ? 'text-signal font-bold' : 'opacity-70'}`}>{s.upvote_count}</span>
        </button>
      ) : (
        <div class="w-12 min-h-[48px] flex flex-col items-center justify-center opacity-50" aria-label={`${s.upvote_count} upvotes`}>
          <span class="text-base leading-none">▲</span>
          <span class="font-mono text-xs leading-tight mt-0.5">{s.upvote_count}</span>
        </div>
      )}
      {(s.comment_count ?? 0) > 0 && (
        <div class="mt-1 flex flex-col items-center opacity-60" aria-label={`${s.comment_count} comment${s.comment_count === 1 ? '' : 's'}`}>
          <span class="text-xs leading-none" aria-hidden="true">💬</span>
          <span class="font-mono text-xs leading-tight mt-0.5">{s.comment_count}</span>
        </div>
      )}
    </div>

    <div data-card-content class="flex-1 min-w-0 py-1">
      <h3 data-card-title class={`font-semibold text-base leading-snug break-words ${titleClass}`}>
        {s.title}
      </h3>

      {s.description && (
        <p data-card-description class="text-sm opacity-70 mt-1 line-clamp-2">{s.description}</p>
      )}

      {hasMeta && (
        <div data-card-meta class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-xs font-mono opacity-60">
          {isScheduled && s.scheduled_start && (
            <span>{fmtSched.format(new Date(s.scheduled_start * 1000))}</span>
          )}
          {isScheduled && s.scheduled_host_email && (
            <span class="opacity-80">→ {hostName}</span>
          )}
          {showAuthor && s.author_email && (
            <span>{authorName}</span>
          )}
          {showTags && tagList.length > 0 && (
            <span class="opacity-80">{tagList.join(' · ')}</span>
          )}
          {shortUrl && (
            <a href={s.url!} target="_blank" rel="noopener noreferrer"
               class="opacity-80 hover:text-signal hover:opacity-100 transition-colors">
              ↗ {shortUrl}
            </a>
          )}
        </div>
      )}

      {hasActions && (
        <div data-card-actions class="mt-3 flex items-center gap-3">
          {isHost && isOpen && (
            <button
              class="schedule-trigger btn btn-sm btn-primary"
              data-topic-id={s.id}
              data-topic-title={s.title}
            >
              Claim &amp; schedule
            </button>
          )}
          {canUnschedule && (
            <button
              class="unschedule-trigger text-xs opacity-60 hover:opacity-100 hover:text-error transition-colors px-2 py-1 -mx-2"
              data-slot-id={s.scheduled_slot_id}
              data-topic-title={s.title}
            >
              Unschedule
            </button>
          )}
        </div>
      )}
    </div>
  </div>
</article>

<script>
  // Card-level click → topic detail page. Skips clicks that landed on
  // an interactive child (button, link) so upvote / schedule / external
  // URL still behave normally. Keyboard equivalent: Enter or Space.
  document.querySelectorAll<HTMLElement>('.topic-card[data-href]').forEach(card => {
    const href = card.dataset.href;
    if (!href) return;
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('button, a')) return;
      window.location.href = href;
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement;
        if (target.closest('button, a')) return;
        e.preventDefault();
        window.location.href = href;
      }
    });
  });
</script>
