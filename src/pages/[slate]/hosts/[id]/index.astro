---
import Layout from '@/layouts/Layout.astro';
import SlateChildPage from '@/components/SlateChildPage.astro';
import ShowNotesView from '@/components/ShowNotesView';
import { getDb, getEnv } from '@/lib/db';
import { isAppAdmin, signInUrl } from '@/lib/auth';
import { displayName } from '@/lib/people';

export const prerender = false;

// Public host wiki page. Long-form markdown body — host's social links,
// donation buttons, org affiliations, intro video embed, recurring
// segments, anything else. Hosts edit their own; App Admins edit
// anyone's. Anyone with the link can read.

const slug = Astro.params.slate;
const hostUserId = Astro.params.id;
if (!slug || !hostUserId) return new Response('Not found', { status: 404 });

const db = getDb(Astro);

const slate = await db.prepare(
  'SELECT id, slug, name, description, timezone, is_public, artwork_image_url FROM slates WHERE slug = ?',
).bind(slug).first<{ id: string; slug: string; name: string; description: string | null; timezone: string; is_public: number; artwork_image_url: string | null }>();
if (!slate) return new Response('Not found', { status: 404 });
if (!slate.is_public) return new Response('Private slate', { status: 403 });

// The host's slate-membership row + their global user profile, in one join.
// 404 if the user isn't a host on this slate (covers both "user not in slate"
// and "user is only a Member").
const host = await db.prepare(
  `SELECT u.id, u.email, u.display_name, u.headshot_url, u.tagline, u.bio, u.link,
          sm.show_name, sm.show_logo_url, sm.profile_body, sm.joined_at, sm.promoted_at
   FROM slate_members sm
   JOIN users u ON u.id = sm.user_id
   WHERE sm.slate_id = ? AND sm.user_id = ? AND sm.role = 'host'`,
).bind(slate.id, hostUserId).first<{
  id: string; email: string;
  display_name: string | null; headshot_url: string | null;
  tagline: string | null; bio: string | null; link: string | null;
  show_name: string | null; show_logo_url: string | null;
  profile_body: string | null;
  joined_at: number; promoted_at: number | null;
}>();
if (!host) return new Response('Host not found', { status: 404 });

const user = Astro.locals.user;
const isAdmin = isAppAdmin(user?.scopes);
const isOwner = !!user && user.id === host.id;
const canEdit = isOwner || isAdmin;

const member = user ? await db.prepare(
  `SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?`,
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>() : null;
const isMember = !!member;
const isHost = (member?.role === 'host' || !!member?.is_admin) || isAdmin;

const env = getEnv(Astro);
const reqUrl = new URL(Astro.request.url);
const signInHref = signInUrl(env, reqUrl.origin, `/${slate.slug}/hosts/${host.id}`);

// Recent episodes hosted by this person, used as a small "what they've
// recorded" rail beneath the wiki.
const recentEpisodes = await db.prepare(
  `SELECT sl.id, sl.start_time, sl.status,
          COALESCE(sl.custom_title, sug.title) AS title
   FROM slots sl
   LEFT JOIN topics sug ON sug.id = sl.topic_id
   WHERE sl.slate_id = ? AND sl.host_id = ?
     AND sl.status IN ('recorded','published','confirmed','assigned')
   ORDER BY sl.start_time DESC
   LIMIT 12`,
).bind(slate.id, host.id).all<{ id: string; start_time: number; status: string; title: string | null }>();

// Revision history of the wiki — short list at the bottom.
const revisions = await db.prepare(
  `SELECT r.id, r.change_summary, r.created_at,
          u.email AS author_email, u.display_name AS author_display_name
   FROM slate_member_revisions r
   LEFT JOIN users u ON u.id = r.author_id
   WHERE r.slate_id = ? AND r.user_id = ?
   ORDER BY r.created_at DESC
   LIMIT 20`,
).bind(slate.id, host.id).all<{
  id: string; change_summary: string | null; created_at: number;
  author_email: string | null; author_display_name: string | null;
}>();

const personName = displayName({ display_name: host.display_name, email: host.email });
const showName = host.show_name;
const pageTitle = showName ?? personName;

const fmtRevision = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, month: 'short', day: 'numeric', year: 'numeric',
  hour: 'numeric', minute: '2-digit',
});
const fmtEpisode = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
});
---

<Layout
  title={`${pageTitle} · ${slate.name}`}
  description={host.bio ?? `${pageTitle} on ${slate.name}`}
  slate={{ name: slate.name, slug: slate.slug, artwork_image_url: slate.artwork_image_url }}
  slateContext={{ isMember, isHost, role: member?.role as 'member' | 'host' | undefined ?? null }}
>
  <SlateChildPage
    parent={{ label: slate.name, href: `/${slate.slug}` }}
    current={pageTitle}
  >
    {/* ─── Header card: artwork/headshot + show + person ─────────────── */}
    <header class="flex flex-wrap items-start gap-5 md:gap-6">
      <div class="shrink-0">
        {host.show_logo_url ? (
          <div class="w-28 h-28 md:w-36 md:h-36 rounded overflow-hidden bg-black border border-base-300">
            <img src={host.show_logo_url} alt="" class="w-full h-full object-contain" />
          </div>
        ) : host.headshot_url ? (
          <img src={host.headshot_url} alt=""
               class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover border border-base-300" />
        ) : (
          <div class="w-28 h-28 md:w-36 md:h-36 rounded-full bg-base-200 border border-base-300 flex items-center justify-center text-5xl font-mono opacity-60">
            {personName.charAt(0).toUpperCase()}
          </div>
        )}
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight leading-tight">{pageTitle}</h1>
        {showName && (
          <p class="text-sm opacity-60 mt-1">hosted by <span class="font-semibold">{personName}</span></p>
        )}
        {host.tagline && (
          <p class="mt-3 text-lg opacity-80 max-w-2xl leading-snug">{host.tagline}</p>
        )}
        {host.bio && (
          <p class="mt-3 text-sm opacity-70 max-w-2xl leading-relaxed">{host.bio}</p>
        )}
        {host.link && (
          <p class="mt-3 text-sm">
            <a href={host.link} target="_blank" rel="noopener noreferrer"
               class="font-mono text-signal hover:underline">
              ↗ {host.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </a>
          </p>
        )}
      </div>
    </header>

    {/* ─── Wiki body ─────────────────────────────────────────────────── */}
    <section class="mt-10 border-t border-base-300 pt-8">
      <header class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl md:text-2xl font-bold">
          <span class="font-mono text-signal text-xs align-middle">// </span>
          About the show
        </h2>
        {canEdit ? (
          <a href={`/${slate.slug}/hosts/${host.id}/edit`} class="btn btn-sm btn-primary">
            {host.profile_body ? 'Edit page' : 'Start page'}
          </a>
        ) : null}
      </header>

      {host.profile_body ? (
        <ShowNotesView client:load markdown={host.profile_body} />
      ) : (
        <div class="rounded border border-dashed border-base-300 bg-base-200/40 p-6 text-center">
          <p class="text-sm opacity-70">
            {canEdit
              ? <>Nothing written here yet. <a href={`/${slate.slug}/hosts/${host.id}/edit`} class="link">Start your page →</a></>
              : <>This host hasn't filled in their page yet.</>}
          </p>
        </div>
      )}
    </section>

    {/* ─── Recent episodes ───────────────────────────────────────────── */}
    {recentEpisodes.results.length > 0 && (
      <section class="mt-10 border-t border-base-300 pt-8">
        <h2 class="text-xl md:text-2xl font-bold mb-4">
          <span class="font-mono text-signal text-xs align-middle">// </span>
          Episodes
        </h2>
        <ul class="divide-y divide-base-300/50 max-w-3xl">
          {recentEpisodes.results.map(e => (
            <li>
              <a href={`/${slate.slug}/slot/${e.id}`}
                 class="block py-3 hover:bg-base-200/40 -mx-2 px-2 rounded transition-colors">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-xs opacity-60 w-24 shrink-0 tabular-nums">
                    {fmtEpisode.format(new Date(e.start_time * 1000))}
                  </span>
                  <span class="font-medium flex-1 min-w-0 truncate">
                    {e.title ?? <span class="opacity-50 italic font-normal">Untitled</span>}
                  </span>
                  <span class={`badge badge-sm ${
                    e.status === 'published' ? 'badge-primary'
                      : e.status === 'recorded' ? 'badge-ghost'
                      : 'badge-outline'
                  }`}>{e.status}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ─── Revision history ──────────────────────────────────────────── */}
    {revisions.results.length > 0 && (
      <section class="mt-10 border-t border-base-300 pt-8">
        <h2 class="text-sm font-mono opacity-60 mb-3">// edits</h2>
        <ul class="text-sm space-y-2">
          {revisions.results.map(r => {
            const editor = r.author_email
              ? displayName({ display_name: r.author_display_name, email: r.author_email })
              : '(unknown)';
            return (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class="font-mono text-xs opacity-50 w-44 shrink-0 tabular-nums">
                  {fmtRevision.format(new Date(r.created_at * 1000))}
                </span>
                <span class="font-semibold">{editor}</span>
                {r.change_summary && (
                  <span class="opacity-70">— {r.change_summary}</span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {!user && (
      <p class="mt-10 text-sm opacity-70">
        <a href={signInHref} class="link link-hover text-signal">Sign in</a> to join this slate and contribute.
      </p>
    )}
  </SlateChildPage>
</Layout>
