---
import Layout from '@/layouts/Layout.astro';
import { getDb } from '@/lib/db';
import { isAppAdmin, signInUrlForCtx } from '@/lib/auth';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/admin/suggestions`));

const db = getDb(Astro);
const slate = await db.prepare('SELECT id, name FROM slates WHERE slug = ?').bind(slug)
  .first<{ id: string; name: string }>();
if (!slate) return new Response('Not found', { status: 404 });

const member = await db.prepare(
  'SELECT role FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string }>();
if (!isAppAdmin(user.scopes) && member?.role !== 'speaker') {
  return new Response('Speaker required', { status: 403 });
}

const contribs = await db.prepare(
  `SELECT s.id, s.title, s.description, s.url, s.tags, s.status, s.upvote_count,
          s.submitted_at, s.scheduled_slot_id, u.email AS author_email
   FROM suggestions s JOIN users u ON u.id = s.author_id
   WHERE s.slate_id = ?
   ORDER BY (s.status = 'open') DESC, s.upvote_count DESC, s.submitted_at DESC`,
).bind(slate.id).all<any>();
---

<Layout title={`Moderate suggestions · ${slate.name}`} slate={{ name: slate.name, slug: slug! }}>
  <section class="py-6 max-w-4xl">
    <div class="flex items-baseline justify-between mb-4">
      <div>
        <p class="font-mono text-sm text-signal mb-1">// {slate.name}</p>
        <h1 class="text-2xl font-bold">Moderate suggestions</h1>
      </div>
      <a href={`/${slug}/admin`} class="btn btn-sm btn-ghost border border-base-300">← Slate admin</a>
    </div>

    <div class="space-y-2">
      {contribs.results.length === 0 && <p class="opacity-60 text-sm">No suggestions yet.</p>}
      {contribs.results.map((c: any) => (
        <div class={`card ${c.status === 'archived' ? 'opacity-50' : 'bg-base-100'} border border-base-300`}>
          <div class="card-body py-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 text-xs">
                  <span class={`badge badge-xs ${c.status === 'open' ? 'badge-success' : c.status === 'scheduled' ? 'badge-primary' : 'badge-ghost'}`}>{c.status}</span>
                  <span class="opacity-60 font-mono">▲ {c.upvote_count}</span>
                  <span class="opacity-50 font-mono">{c.author_email}</span>
                </div>
                <h2 class="card-title text-base mt-1">
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer" class="link">{c.title}</a>
                  ) : c.title}
                </h2>
                {c.description && <p class="text-sm opacity-80 mt-1">{c.description}</p>}
                {c.tags && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {c.tags.split(',').map((t: string) => t.trim()).filter(Boolean).map((t: string) => (
                      <span class="badge badge-xs badge-ghost font-mono">{t}</span>
                    ))}
                  </div>
                )}
              </div>
              {c.status !== 'archived' && c.status !== 'scheduled' && (
                <button data-id={c.id} data-status="archived"
                        class="contrib-action btn btn-xs btn-ghost border border-base-300 text-error">archive</button>
              )}
              {c.status === 'archived' && (
                <button data-id={c.id} data-status="open"
                        class="contrib-action btn btn-xs btn-ghost border border-base-300">restore</button>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.contrib-action').forEach(b => {
      b.addEventListener('click', async () => {
        const { id, status } = b.dataset;
        b.disabled = true;
        const res = await fetch(`/api/admin/suggestions/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ status }),
        });
        if (res.ok) location.reload();
        else { b.disabled = false; alert((await res.json().catch(() => ({}))).error ?? res.status); }
      });
    });
  </script>
</Layout>
