---
import Layout from '@/layouts/Layout.astro';
import SlateChildPage from '@/components/SlateChildPage.astro';
import ScheduleTopicPanel from '@/components/ScheduleTopicPanel.astro';
import TopicCard from '@/components/TopicCard.astro';
import { getDb, getEnv } from '@/lib/db';
import { signInUrl, isAppAdmin } from '@/lib/auth';

export const prerender = false;

// Topic archive — public read for anyone with the link to a public slate;
// member/host gates only apply to interactive bits (vote, suggest, claim).
// Replaces the previous all-members-only design so the "See all →" link
// on the marquee works for anonymous listeners exploring the slate.

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const db = getDb(Astro);
const slate = await db.prepare(
  'SELECT id, name, is_public, timezone, artwork_image_url FROM slates WHERE slug = ?',
).bind(slug).first<{ id: string; name: string; is_public: number; timezone: string; artwork_image_url: string | null }>();
if (!slate) return new Response('Not found', { status: 404 });
if (!slate.is_public) return new Response('Private slate', { status: 403 });

const user = Astro.locals.user;
const env = getEnv(Astro);
const reqUrl = new URL(Astro.request.url);
const signInHref = signInUrl(env, reqUrl.origin, `/${slug}/topics`);

const isAdmin = isAppAdmin(user?.scopes);
const member = user ? await db.prepare(
  'SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>() : null;
const isMember = !!member;
const isHost = isAdmin || (member?.role === 'host' || !!member?.is_admin);

const status = reqUrl.searchParams.get('status') ?? 'open';

const where = status === 'all' ? 's.slate_id = ?' : 's.slate_id = ? AND s.status = ?';
const params: unknown[] = status === 'all' ? [slate.id] : [slate.id, status];

// `has_voted` requires a user id for the subquery; pass empty string when
// anonymous so the subquery returns nothing rather than NULL-comparing.
const topics = await db.prepare(
  `SELECT s.id, s.title, s.description, s.url, s.tags, s.status, s.upvote_count,
          s.submitted_at, s.scheduled_slot_id,
          u.email AS author_email, u.display_name AS author_display_name,
          sl.start_time AS scheduled_start, sl.duration_minutes AS scheduled_duration,
          sl.host_id AS scheduled_host_id,
          spk.email AS scheduled_host_email,
          spk.display_name AS scheduled_host_display_name,
          (SELECT 1 FROM topic_votes v WHERE v.topic_id = s.id AND v.user_id = ?) AS has_voted,
          COALESCE(cc.n, 0) AS comment_count
   FROM topics s
   JOIN users u ON u.id = s.author_id
   LEFT JOIN slots sl ON sl.id = s.scheduled_slot_id
   LEFT JOIN users spk ON spk.id = sl.host_id
   LEFT JOIN (
     SELECT topic_id, COUNT(*) AS n
     FROM comments
     WHERE deleted_at IS NULL
     GROUP BY topic_id
   ) cc ON cc.topic_id = s.id
   WHERE ${where}
   ORDER BY (s.status = 'open') DESC, s.upvote_count DESC, s.submitted_at DESC`,
).bind(user?.id ?? '', ...params).all<any>();

const fmtSched = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit',
});
---

<Layout
  title={`Topics · ${slate.name}`}
  slate={{ name: slate.name, slug: slug!, artwork_image_url: slate.artwork_image_url }}
  slateContext={{ isMember, isHost, role: member?.role as 'member' | 'host' | undefined ?? null }}
>
  <SlateChildPage>
    <div class="flex items-baseline justify-between mb-4 gap-4 flex-wrap">
      <h1 class="text-2xl font-bold">Topic pool</h1>
      {isMember || isAdmin ? (
        <a href={`/${slug}/topics/new`} class="btn btn-primary btn-sm">+ Suggest</a>
      ) : user ? (
        <a href={`/${slug}/join`} class="btn btn-primary btn-sm">Join to suggest</a>
      ) : (
        <a href={signInHref} class="btn btn-primary btn-sm">Sign in to suggest</a>
      )}
    </div>

    <div class="flex gap-2 mb-6 text-sm">
      {(['open','scheduled','archived','all'] as const).map(s => (
        <a href={`?status=${s}`} class={`btn btn-xs ${status === s ? 'btn-primary' : 'btn-ghost border border-base-300'}`}>{s}</a>
      ))}
    </div>

    <div class="space-y-3">
      {topics.results.length === 0 && <p class="opacity-60 text-sm">No topics match.</p>}
      {topics.results.map((s: any) => (
        <TopicCard
          s={s}
          slateSlug={slug!}
          isMember={isMember}
          isHost={isHost}
          currentUserId={user?.id}
          isAdmin={isAdmin}
          fmtSched={fmtSched}
          showAuthor
          showTags
        />
      ))}
    </div>

  </SlateChildPage>

  {isHost && <ScheduleTopicPanel slate={{ id: slate.id, slug: slug!, name: slate.name }} />}

  <script is:inline define:vars={{ isMember, signInHref }}>
    // Vote — members + hosts only. Anonymous click → sign-in bounce.
    document.querySelectorAll('.upvote').forEach(b => {
      b.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!isMember) { window.location.href = signInHref; return; }
        b.disabled = true;
        const res = await fetch(`/api/topics/${b.dataset.id}/vote`, { method: 'POST' });
        if (res.ok) {
          const body = await res.json();
          const voted = !!body.has_voted;
          const arrow = b.querySelector('[data-vote-arrow]');
          const count = b.querySelector('[data-vote-count]');
          arrow.classList.toggle('text-signal', voted);
          arrow.classList.toggle('opacity-40', !voted);
          count.classList.toggle('text-signal', voted);
          count.classList.toggle('font-bold', voted);
          count.classList.toggle('opacity-70', !voted);
          count.textContent = body.upvote_count;
          const card = b.closest('[data-topic-card]');
          card?.classList.toggle('border-signal', voted);
          card?.classList.toggle('border-base-300', !voted);
        } else {
          alert((await res.json().catch(() => ({}))).error ?? res.status);
        }
        b.disabled = false;
      });
    });

    // Schedule / unschedule — host-only buttons. Anonymous viewers don't
    // see them (TopicCard only renders the controls when isHost), so
    // these handlers are no-ops for them.
    document.querySelectorAll('.schedule-trigger').forEach(b => {
      b.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('schedule-topic', {
          detail: {
            topicId: b.dataset.topicId,
            topicTitle: b.dataset.topicTitle,
          },
        }));
      });
    });

    document.querySelectorAll('.unschedule-trigger').forEach(b => {
      b.addEventListener('click', async () => {
        if (!confirm(`Unschedule "${b.dataset.topicTitle}"? The slot goes back to open.`)) return;
        b.disabled = true;
        const res = await fetch(`/api/slots/${b.dataset.slotId}/claim-and-schedule`, { method: 'DELETE' });
        if (res.ok) location.reload();
        else { b.disabled = false; alert((await res.json().catch(() => ({}))).error ?? res.status); }
      });
    });
  </script>
</Layout>
