---
import Layout from '@/layouts/Layout.astro';
import EditSubnav from '@/components/EditSubnav.astro';
import SlotsAGGrid from '@/components/SlotsAGGrid';
import { getDb } from '@/lib/db';
import { isAppAdmin, signInUrlForCtx } from '@/lib/auth';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/edit/slots`));

const db = getDb(Astro);
const slate = await db.prepare('SELECT id, name, timezone, artwork_image_url FROM slates WHERE slug = ?').bind(slug)
  .first<{ id: string; name: string; timezone: string; artwork_image_url: string | null }>();
if (!slate) return new Response('Not found', { status: 404 });

const member = await db.prepare(
  'SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>();
if (!isAppAdmin(user.scopes) && member?.role !== 'host') {
  return new Response('Host required', { status: 403 });
}

const rows = await db.prepare(
  `SELECT sl.id, sl.start_time, sl.duration_minutes, sl.status, sl.custom_title, sl.notes_internal, sl.rule_id,
          sl.host_id, sl.topic_id, sl.show_id,
          spk.email AS host_email,
          spk.display_name AS host_display_name,
          sug.title AS topic_title,
          sh.slug AS show_slug,
          sh.name AS show_name
   FROM slots sl
   LEFT JOIN users spk ON spk.id = sl.host_id
   LEFT JOIN topics sug ON sug.id = sl.topic_id
   LEFT JOIN shows sh ON sh.id = sl.show_id
   WHERE sl.slate_id = ?
   ORDER BY sl.start_time`,
).bind(slate.id).all<any>();
---

<Layout title={`Slots · ${slate.name}`} slate={{ name: slate.name, slug: slug!, artwork_image_url: slate.artwork_image_url }}
        slateContext={{ isMember: true, isHost: true, role: 'host' }}>
  <EditSubnav slug={slug!} isHost={true} current="slots" />
  <section class="py-6">
    <div class="flex items-baseline justify-between mb-4">
      <div>
        <p class="font-mono text-sm text-signal mb-1">// {slate.name} · {slate.timezone}</p>
        <h1 class="text-2xl font-bold">Slots — sheet view</h1>
        <p class="text-xs opacity-60 mt-1">Inline edit, multi-select, copy/paste. Save commits a single batched update.</p>
      </div>
      <div class="flex gap-2">
        <a href={`/api/slates/${slate.id}/edit/export.csv`} class="btn btn-sm btn-ghost border border-base-300">↓ Export CSV</a>
      </div>
    </div>

    <SlotsAGGrid
      client:only="react"
      slateId={slate.id}
      timezone={slate.timezone}
      rows={rows.results}
    />
  </section>
</Layout>
