---
import Layout from '@/layouts/Layout.astro';
import EditSubnav from '@/components/EditSubnav.astro';
import ScheduleTopicPanel from '@/components/ScheduleTopicPanel.astro';
import { getDb } from '@/lib/db';
import { isAppAdmin, signInUrlForCtx } from '@/lib/auth';
import { displayName } from '@/lib/people';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/edit/archive`));

const db = getDb(Astro);
const slate = await db.prepare('SELECT id, name, timezone, artwork_image_url FROM slates WHERE slug = ?').bind(slug)
  .first<{ id: string; name: string; timezone: string; artwork_image_url: string | null }>();
if (!slate) return new Response('Not found', { status: 404 });

const member = await db.prepare(
  'SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>();
if (!isAppAdmin(user.scopes) && member?.role !== 'host') {
  return new Response('Host required', { status: 403 });
}
const isAdmin = isAppAdmin(user.scopes);

const contribs = await db.prepare(
  `SELECT s.id, s.title, s.description, s.url, s.tags, s.status, s.upvote_count,
          s.submitted_at, s.scheduled_slot_id,
          u.email AS author_email, u.display_name AS author_display_name,
          sl.start_time AS scheduled_start, sl.duration_minutes AS scheduled_duration,
          sl.host_id AS scheduled_host_id,
          spk.email AS scheduled_host_email,
          spk.display_name AS scheduled_host_display_name
   FROM topics s
   JOIN users u ON u.id = s.author_id
   LEFT JOIN slots sl ON sl.id = s.scheduled_slot_id
   LEFT JOIN users spk ON spk.id = sl.host_id
   WHERE s.slate_id = ?
   ORDER BY (s.status = 'open') DESC, s.upvote_count DESC, s.submitted_at DESC`,
).bind(slate.id).all<any>();

const fmtSched = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit',
});
---

<Layout title={`Archive · ${slate.name}`} slate={{ name: slate.name, slug: slug!, artwork_image_url: slate.artwork_image_url }}
        slateContext={{ isMember: true, isHost: true, role: 'host' }}>
  <EditSubnav slug={slug!} isHost={true} current="archive" />
  <section class="py-6 max-w-4xl">
    <div class="flex items-baseline justify-between mb-4">
      <div>
        <p class="font-mono text-sm text-signal mb-1">// {slate.name}</p>
        <h1 class="text-2xl font-bold">Moderate topics</h1>
      </div>
    </div>

    <div class="space-y-2">
      {contribs.results.length === 0 && <p class="opacity-60 text-sm">No topics yet.</p>}
      {contribs.results.map((c: any) => (
        <div class={`card ${c.status === 'archived' ? 'opacity-50' : 'bg-base-100'} border border-base-300`}>
          <div class="card-body py-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 text-xs">
                  <span class={`badge badge-xs ${c.status === 'open' ? 'badge-success' : c.status === 'scheduled' ? 'badge-primary' : 'badge-ghost'}`}>{c.status}</span>
                  <span class="opacity-60 font-mono">▲ {c.upvote_count}</span>
                  <span class="opacity-50 font-mono">{displayName({ display_name: c.author_display_name, email: c.author_email })}</span>
                </div>
                <h2 class="card-title text-base mt-1">
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer" class="link">{c.title}</a>
                  ) : c.title}
                </h2>
                {c.description && <p class="text-sm opacity-80 mt-1">{c.description}</p>}
                {c.tags && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {c.tags.split(',').map((t: string) => t.trim()).filter(Boolean).map((t: string) => (
                      <span class="badge badge-xs badge-ghost font-mono">{t}</span>
                    ))}
                  </div>
                )}
                {c.status === 'scheduled' && c.scheduled_start && (
                  <p class="text-xs mt-2 font-mono opacity-75">
                    📅 {fmtSched.format(new Date(c.scheduled_start * 1000))}
                    {c.scheduled_host_email && <span class="opacity-60"> · {displayName({ display_name: c.scheduled_host_display_name, email: c.scheduled_host_email })}</span>}
                  </p>
                )}
                {c.status === 'open' && (
                  <button class="schedule-trigger btn btn-xs btn-primary mt-3"
                          data-topic-id={c.id}
                          data-topic-title={c.title}>
                    Claim &amp; schedule
                  </button>
                )}
                {c.status === 'scheduled' && c.scheduled_slot_id &&
                  (c.scheduled_host_id === user.id || isAdmin) && (
                  <button class="unschedule-trigger btn btn-xs btn-ghost border border-base-300 mt-3 text-error"
                          data-slot-id={c.scheduled_slot_id}
                          data-topic-title={c.title}>
                    Unschedule
                  </button>
                )}
              </div>
              {c.status !== 'archived' && c.status !== 'scheduled' && (
                <button data-id={c.id} data-status="archived"
                        class="contrib-action btn btn-xs btn-ghost border border-base-300 text-error">archive</button>
              )}
              {c.status === 'archived' && (
                <button data-id={c.id} data-status="open"
                        class="contrib-action btn btn-xs btn-ghost border border-base-300">restore</button>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <ScheduleTopicPanel slate={{ id: slate.id, slug: slug!, name: slate.name }} />

  <script is:inline>
    document.querySelectorAll('.contrib-action').forEach(b => {
      b.addEventListener('click', async () => {
        const { id, status } = b.dataset;
        b.disabled = true;
        const res = await fetch(`/api/admin/topics/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ status }),
        });
        if (res.ok) location.reload();
        else { b.disabled = false; alert((await res.json().catch(() => ({}))).error ?? res.status); }
      });
    });

    document.querySelectorAll('.schedule-trigger').forEach(b => {
      b.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('schedule-topic', {
          detail: {
            topicId: b.dataset.topicId,
            topicTitle: b.dataset.topicTitle,
          },
        }));
      });
    });

    document.querySelectorAll('.unschedule-trigger').forEach(b => {
      b.addEventListener('click', async () => {
        if (!confirm(`Unschedule "${b.dataset.topicTitle}"? The slot goes back to open.`)) return;
        b.disabled = true;
        const res = await fetch(`/api/slots/${b.dataset.slotId}/claim-and-schedule`, { method: 'DELETE' });
        if (res.ok) location.reload();
        else { b.disabled = false; alert((await res.json().catch(() => ({}))).error ?? res.status); }
      });
    });
  </script>
</Layout>
