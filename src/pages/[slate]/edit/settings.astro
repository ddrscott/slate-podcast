---
import Layout from '@/layouts/Layout.astro';
import EditSubnav from '@/components/EditSubnav.astro';
import { getDb } from '@/lib/db';
import { isAppAdmin, signInUrlForCtx } from '@/lib/auth';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/edit/settings`));

const db = getDb(Astro);
const slate = await db.prepare(
  `SELECT id, slug, name, description, timezone, is_public, cover_image_url FROM slates WHERE slug = ?`,
).bind(slug).first<{
  id: string; slug: string; name: string; description: string | null;
  timezone: string; is_public: number; cover_image_url: string | null;
}>();
if (!slate) return new Response('Not found', { status: 404 });

const member = await db.prepare(
  'SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>();
if (!isAppAdmin(user.scopes) && member?.role !== 'host') {
  return new Response('Host required', { status: 403 });
}
---

<Layout title={`Settings · ${slate.name}`} slate={{ name: slate.name, slug: slug! }}
        slateContext={{ isMember: true, isHost: true, role: 'host' }}>
  <EditSubnav slug={slug!} isHost={true} current="settings" />
  <section class="py-8 max-w-2xl">
    <p class="font-mono text-sm text-signal mb-1">// {slate.name}</p>
    <h1 class="text-2xl font-bold">Slate settings</h1>
    <p class="opacity-75 text-sm mt-1 mb-6">
      Changing the slug breaks the old public URL — useful for soft privacy.
    </p>

    {/* Cover image — separate from the settings form because it's a binary
        upload, not a JSON PATCH. Uses /api/slates/[id]/cover (host-only). */}
    <div class="mb-8 pb-6 border-b border-base-300">
      <h2 class="font-semibold text-sm mb-2">Cover image</h2>
      <p class="text-xs opacity-60 mb-3">Hero artwork for the public landing page. Optional.</p>
      <div class="flex items-start gap-4">
        <div id="cover-preview" class="w-40 aspect-[16/9] rounded border border-base-300 bg-base-200 overflow-hidden flex items-center justify-center text-xs opacity-60">
          {slate.cover_image_url
            ? <img src={slate.cover_image_url} alt="" class="w-full h-full object-cover" />
            : <span class="font-mono">no image</span>}
        </div>
        <div class="flex flex-col gap-2">
          <label class="btn btn-xs btn-ghost border border-base-300 cursor-pointer w-fit">
            <input id="cover-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
            {slate.cover_image_url ? 'Replace' : 'Upload'}
          </label>
          {slate.cover_image_url && (
            <button id="cover-remove" type="button" class="btn btn-xs btn-ghost border border-base-300 text-error w-fit">Remove</button>
          )}
          <span id="cover-status" class="text-xs opacity-70"></span>
        </div>
      </div>
    </div>

    <form id="settings-form" class="space-y-4">
      <label class="form-control">
        <span class="label-text">Name</span>
        <input name="name" required maxlength="120" class="input input-bordered" value={slate.name} />
      </label>
      <label class="form-control">
        <span class="label-text">Slug (URL identifier)</span>
        <input name="slug" required maxlength="64" class="input input-bordered font-mono"
               value={slate.slug} autocapitalize="off" autocorrect="off" spellcheck="false" />
        <span class="text-xs opacity-60 mt-1">Public URL: <code id="slug-preview">/{slate.slug}</code></span>
      </label>
      <label class="form-control">
        <span class="label-text">Description</span>
        <textarea name="description" rows="3" maxlength="1000" class="textarea textarea-bordered">{slate.description ?? ''}</textarea>
      </label>
      <label class="form-control">
        <span class="label-text">Timezone</span>
        <select name="timezone" required class="select select-bordered">
          {['America/New_York','America/Chicago','America/Denver','America/Los_Angeles','America/Phoenix','America/Anchorage','Pacific/Honolulu','UTC','Europe/London','Europe/Berlin','Australia/Sydney'].map(tz => (
            <option value={tz} selected={tz === slate.timezone}>{tz}</option>
          ))}
        </select>
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="is_public" class="checkbox" checked={slate.is_public === 1} />
        <span class="label-text">Public — schedule visible to anyone with the URL</span>
      </label>
      <button type="submit" class="btn btn-primary">Save</button>
      <p id="status" class="text-sm hidden"></p>
    </form>

  </section>

  <script is:inline define:vars={{ slateId: slate.id }}>
    (() => {
      const input = document.getElementById('cover-input');
      const removeBtn = document.getElementById('cover-remove');
      const status = document.getElementById('cover-status');
      const preview = document.getElementById('cover-preview');

      function setStatus(msg, kind) {
        status.classList.remove('text-error', 'text-success');
        if (kind) status.classList.add(`text-${kind}`);
        status.textContent = msg ?? '';
      }

      input?.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { setStatus('File too large (max 5 MB).', 'error'); return; }
        setStatus('Uploading…');
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch(`/api/slates/${slateId}/cover`, { method: 'POST', body: fd });
        if (res.ok) {
          const body = await res.json();
          preview.innerHTML = `<img src="${body.cover_image_url}" alt="" class="w-full h-full object-cover" />`;
          setStatus('Saved.', 'success');
          setTimeout(() => location.reload(), 600);
        } else {
          const e = await res.json().catch(() => ({}));
          setStatus(`Failed: ${e.error ?? res.status}`, 'error');
        }
      });

      removeBtn?.addEventListener('click', async () => {
        if (!confirm('Remove the cover image?')) return;
        setStatus('Removing…');
        const res = await fetch(`/api/slates/${slateId}/cover`, { method: 'DELETE' });
        if (res.ok) location.reload();
        else { const e = await res.json().catch(() => ({})); setStatus(`Failed: ${e.error ?? res.status}`, 'error'); }
      });
    })();
  </script>

  <script is:inline define:vars={{ slateId: slate.id, currentSlug: slate.slug }}>
    const form = document.getElementById('settings-form');
    const status = document.getElementById('status');
    const slugInput = form.querySelector('[name=slug]');
    const slugPreview = document.getElementById('slug-preview');

    // Live-normalize the slug as the user types so the saved value matches
    // what they see. Mirrors the server-side slugify() in src/lib/db.ts.
    function normalizeSlug(s) {
      return s.toLowerCase()
        .normalize('NFKD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 64);
    }
    slugInput.addEventListener('input', () => {
      const cleaned = normalizeSlug(slugInput.value);
      if (cleaned !== slugInput.value) {
        const pos = slugInput.selectionStart;
        slugInput.value = cleaned;
        slugInput.setSelectionRange?.(pos, pos);
      }
      slugPreview.textContent = `/${cleaned}`;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const newSlug = data.get('slug');
      status.classList.remove('hidden', 'text-error', 'text-success');
      status.textContent = 'Saving…';
      const res = await fetch(`/api/slates/${slateId}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          slug: newSlug,
          description: data.get('description') || null,
          timezone: data.get('timezone'),
          is_public: form.querySelector('[name=is_public]').checked,
        }),
      });
      if (res.ok) {
        if (newSlug !== currentSlug) {
          location.href = `/${newSlug}/edit/settings`;
        } else {
          status.classList.add('text-success');
          status.textContent = 'Saved.';
        }
      } else {
        const e = await res.json().catch(() => ({}));
        status.classList.add('text-error');
        status.textContent = `Failed: ${e.error ?? res.status}`;
      }
    });
  </script>
</Layout>
