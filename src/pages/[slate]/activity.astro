---
import Layout from '@/layouts/Layout.astro';
import ActivityTokens from '@/components/ActivityTokens.astro';
import { getDb } from '@/lib/db';
import { signInUrlForCtx, isAppAdmin } from '@/lib/auth';
import { renderActivity } from '@/lib/activity';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/activity`));

const db = getDb(Astro);
const slate = await db.prepare('SELECT id, name, timezone, is_public FROM slates WHERE slug = ?').bind(slug)
  .first<{ id: string; name: string; timezone: string; is_public: number }>();
if (!slate) return new Response('Not found', { status: 404 });

const isAdmin = isAppAdmin(user.scopes);
const member = await db.prepare(
  'SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>();
if (!isAdmin && !member) return Astro.redirect(`/${slug}/join`);

const seen = await db.prepare(
  'SELECT watermark_at FROM activity_seen WHERE user_id = ? AND slate_id = ?',
).bind(user.id, slate.id).first<{ watermark_at: number }>();
const watermark = seen?.watermark_at ?? 0;

const rows = await db.prepare(
  `SELECT a.id, a.kind, a.created_at, a.meta,
          actor.email AS actor_email, actor.display_name AS actor_display_name,
          target.email AS target_email, target.display_name AS target_display_name,
          a.topic_id, sug.title AS topic_title,
          a.slot_id, sl.start_time AS slot_start
   FROM activity a
   LEFT JOIN users  actor  ON actor.id  = a.actor_id
   LEFT JOIN users  target ON target.id = a.target_user_id
   LEFT JOIN topics sug ON sug.id = a.topic_id
   LEFT JOIN slots sl ON sl.id = a.slot_id
   WHERE a.slate_id = ?
   ORDER BY a.created_at DESC
   LIMIT 100`,
).bind(slate.id).all<any>();

const fmtRel = (sec: number) => {
  const d = new Date(sec * 1000);
  const diff = (Date.now() - sec * 1000) / 1000;
  if (diff < 60) return 'just now';
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 7 * 86400) return `${Math.floor(diff / 86400)}d ago`;
  return new Intl.DateTimeFormat('en-US', {
    timeZone: slate.timezone, month: 'short', day: 'numeric',
  }).format(d);
};

const fmtSlotTime = (sec: number) => new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit',
}).format(new Date(sec * 1000));

const renderCtx = { slug: slug!, fmtSlotTime };

const unreadCount = rows.results.filter((r: any) => r.created_at > watermark).length;
---

<Layout title={`Activity · ${slate.name}`} slate={{ name: slate.name, slug: slug! }}>
  <section class="py-6 max-w-3xl">
    <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
      <div>
        <p class="font-mono text-sm text-signal mb-1">// {slate.name}</p>
        <h1 class="text-2xl font-bold flex items-baseline gap-2">
          Activity
          {unreadCount > 0 && <span class="badge badge-sm badge-primary">{unreadCount} new</span>}
        </h1>
        <p class="text-xs opacity-60 mt-1">Newest first. Catch up on what's changed since you last looked.</p>
      </div>
      <div class="flex gap-2">
        {unreadCount > 0 && (
          <button id="mark-read-btn" class="btn btn-sm btn-primary">Mark all as read</button>
        )}
        <a href={`/${slug}`} class="btn btn-sm btn-ghost border border-base-300">← Schedule</a>
      </div>
    </div>

    <ul class="space-y-1">
      {rows.results.length === 0 && (
        <li class="opacity-60 text-sm py-4">Nothing's happened on this slate yet.</li>
      )}
      {rows.results.map((r: any) => {
        const isNew = r.created_at > watermark;
        const meta = r.meta ? JSON.parse(r.meta) : {};
        const tokens = renderActivity({ ...r, meta }, renderCtx);
        return (
          <li class={`flex items-start gap-3 p-3 border rounded ${isNew ? 'border-signal bg-signal-50' : 'border-base-300 bg-base-100 opacity-90'}`}>
            <div class={`mt-1 h-2 w-2 rounded-full shrink-0 ${isNew ? 'bg-signal' : 'bg-base-300'}`} aria-hidden="true"></div>
            <div class="flex-1 min-w-0">
              <p class="text-sm leading-relaxed">
                <ActivityTokens tokens={tokens} />
              </p>
              <p class="text-xs opacity-50 font-mono mt-1">{fmtRel(r.created_at)}</p>
            </div>
          </li>
        );
      })}
    </ul>

    {rows.results.length === 100 && (
      <p class="text-xs opacity-50 mt-4 text-center">Showing the most recent 100 events.</p>
    )}
  </section>

  <script is:inline define:vars={{ slateId: slate.id }}>
    document.getElementById('mark-read-btn')?.addEventListener('click', async () => {
      const res = await fetch(`/api/slates/${slateId}/activity/mark-read`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
      });
      if (res.ok) location.reload();
      else alert((await res.json().catch(() => ({}))).error ?? res.status);
    });
  </script>
</Layout>
