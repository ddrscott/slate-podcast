---
import Layout from '@/layouts/Layout.astro';
import SlateChildPage from '@/components/SlateChildPage.astro';
import { getDb } from '@/lib/db';
import { isAppAdmin } from '@/lib/auth';
import { displayName } from '@/lib/people';

export const prerender = false;

// Public roster of all shows in the slate. Same data as the marquee's
// retired shows-grid section, but given its own page so the home page
// can stay focused on next-up / topics / past episodes.

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const db = getDb(Astro);
const slate = await db.prepare(
  `SELECT id, slug, name, description, timezone, is_public, artwork_image_url
   FROM slates WHERE slug = ?`,
).bind(slug).first<{
  id: string; slug: string; name: string; description: string | null;
  timezone: string; is_public: number; artwork_image_url: string | null;
}>();
if (!slate) return new Response('Not found', { status: 404 });
if (!slate.is_public) return new Response('Private slate', { status: 403 });

const user = Astro.locals.user;
const member = user ? await db.prepare(
  `SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?`,
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>() : null;
const isMember = !!member;
const isHost = (member?.role === 'host' || !!member?.is_admin) || isAppAdmin(user?.scopes);

const shows = await db.prepare(
  `SELECT s.id, s.slug, s.name, s.description, s.cover_image_url,
          s.host_id,
          u.display_name AS host_display_name,
          u.email        AS host_email,
          u.headshot_url AS host_headshot_url,
          COUNT(DISTINCT CASE
            WHEN sl.start_time < unixepoch() AND sl.status IN ('recorded','published')
            THEN sl.id END) AS episode_count,
          MAX(CASE
            WHEN sl.start_time >= unixepoch() AND sl.status != 'cancelled'
            THEN 1 ELSE 0 END) AS has_upcoming
   FROM shows s
   LEFT JOIN users u ON u.id = s.host_id
   LEFT JOIN slots sl ON sl.show_id = s.id
   WHERE s.slate_id = ?
   GROUP BY s.id
   ORDER BY episode_count DESC, LOWER(s.name)`,
).bind(slate.id).all<{
  id: string; slug: string; name: string;
  description: string | null; cover_image_url: string | null;
  host_id: string | null;
  host_display_name: string | null; host_email: string | null;
  host_headshot_url: string | null;
  episode_count: number; has_upcoming: number;
}>();

const hostNameOrFallback = (display: string | null, email: string | null) =>
  email ? displayName({ display_name: display, email }) : '(unassigned)';

const showCount = shows.results.length;
---

<Layout
  title={`Shows · ${slate.name}`}
  description={`All shows on ${slate.name}`}
  slate={{ name: slate.name, slug: slate.slug, artwork_image_url: slate.artwork_image_url }}
  slateContext={{ isMember, isHost, role: member?.role as 'member' | 'host' | undefined ?? null }}
>
  <SlateChildPage width="wide">
    <header class="flex items-baseline justify-between mb-6">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight">Shows</h1>
      <span class="font-mono text-xs opacity-50">
        {showCount} {showCount === 1 ? 'show' : 'shows'}
      </span>
    </header>

    {shows.results.length === 0 ? (
      <div class="rounded border border-dashed border-base-300 bg-base-200/40 p-8 text-center">
        <p class="text-sm opacity-70">No shows yet on {slate.name}.</p>
      </div>
    ) : (
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {shows.results.map(s => {
          const hostLabel = s.host_email ? hostNameOrFallback(s.host_display_name, s.host_email) : null;
          return (
          <li>
            <a href={`/${slate.slug}/shows/${s.slug}`}
               class="group flex gap-5 p-5 rounded-lg border border-base-300 hover:border-signal transition-colors h-full">
              <div class="shrink-0">
                {s.cover_image_url ? (
                  <div class="w-20 h-20 md:w-24 md:h-24 rounded overflow-hidden bg-black border border-base-300">
                    <img src={s.cover_image_url} alt="" class="w-full h-full object-contain" />
                  </div>
                ) : (
                  <div class="w-20 h-20 md:w-24 md:h-24 rounded bg-gradient-to-br from-signal/15 to-base-200 border border-base-300 flex items-center justify-center text-3xl font-mono opacity-60">
                    {s.name.charAt(0).toUpperCase()}
                  </div>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline gap-2">
                  <span class="font-bold text-base md:text-lg truncate group-hover:text-signal transition-colors">{s.name}</span>
                  {s.episode_count > 0 && (
                    <span class="font-mono text-xs opacity-50 shrink-0">{s.episode_count} ep</span>
                  )}
                </div>
                {hostLabel && (
                  <p class="text-xs opacity-60 mt-1 line-clamp-1 flex items-center gap-1.5">
                    {s.host_headshot_url && (
                      <img src={s.host_headshot_url} alt="" class="w-4 h-4 rounded-full object-cover" />
                    )}
                    <span>hosted by {hostLabel}</span>
                  </p>
                )}
                {s.description && (
                  <p class="text-sm opacity-80 mt-2 line-clamp-3 leading-snug">{s.description}</p>
                )}
                {s.has_upcoming === 1 && (
                  <p class="mt-3 font-mono text-xs text-signal opacity-80">
                    upcoming →
                  </p>
                )}
              </div>
            </a>
          </li>
          );
        })}
      </ul>
    )}
  </SlateChildPage>
</Layout>
