---
import Layout from '@/layouts/Layout.astro';
import { getDb } from '@/lib/db';
import { signInUrlForCtx } from '@/lib/auth';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const db = getDb(Astro);
const slate = await db.prepare(
  `SELECT id, name, description, is_public FROM slates WHERE slug = ?`,
).bind(slug).first<{ id: string; name: string; description: string | null; is_public: number }>();
if (!slate) return new Response('Not found', { status: 404 });

const user = Astro.locals.user;
if (!user) return Astro.redirect(signInUrlForCtx(Astro, `/${slug}/join`));

const member = await db.prepare(
  'SELECT role FROM slate_members WHERE slate_id = ? AND user_id = ?',
).bind(slate.id, user.id).first<{ role: string }>();
---

<Layout title={`Join ${slate.name}`} slate={{ name: slate.name, slug: slug! }}>
  <section class="py-8 max-w-md mx-auto">
    <h1 class="text-2xl font-bold">{slate.name}</h1>
    {slate.description && <p class="opacity-75 mt-2">{slate.description}</p>}

    {member ? (
      <div class="alert alert-success mt-6">
        <span>You're already a {member.role} on this slate. <a href={`/${slug}`} class="link">Open schedule →</a></span>
      </div>
    ) : !slate.is_public ? (
      <div class="alert alert-warning mt-6">
        <span>This slate is private. Ask the App Admin to grant you access.</span>
      </div>
    ) : (
      <div class="mt-6">
        <p class="text-sm opacity-75 mb-4">
          As a Member, you can post topic suggestions and upvote others. Only Speakers (granted by the App Admin) can edit the calendar.
        </p>
        <button id="join-btn" class="btn btn-primary w-full">Join as Member</button>
        <p id="status" class="mt-3 text-sm hidden"></p>
      </div>
    )}

    <p class="mt-6 text-sm"><a href={`/${slug}`} class="link">← Back to schedule</a></p>
  </section>

  <script is:inline define:vars={{ slateId: slate.id, slug }}>
    const btn = document.getElementById('join-btn');
    const status = document.getElementById('status');
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      status.classList.remove('hidden', 'text-error', 'text-success');
      status.textContent = 'Joining…';
      const res = await fetch(`/api/slates/${slateId}/join`, { method: 'POST' });
      if (res.ok) location.href = `/${slug}`;
      else { btn.disabled = false; const e = await res.json().catch(() => ({})); status.classList.add('text-error'); status.textContent = `Failed: ${e.error ?? res.status}`; }
    });
  </script>
</Layout>
