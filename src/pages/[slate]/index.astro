---
import Layout from '@/layouts/Layout.astro';
import SlateMarquee from '@/components/SlateMarquee.astro';
import { getDb, getEnv } from '@/lib/db';
import { isAppAdmin, signInUrl } from '@/lib/auth';

export const prerender = false;

// Public landing page for a slate. Always renders the network-marquee
// view regardless of who's looking — visitors, signed-in non-members,
// members, and hosts all land here. Members navigate to /[slate]/edit
// for everything else (vote/suggest/claim, plus host-only sub-tabs:
// settings, people, rules, slots, archive). The "Open dashboard" CTA
// on the marquee gets them there.

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const db = getDb(Astro);
const slate = await db.prepare(
  `SELECT id, slug, name, description, timezone, is_public,
          cover_image_url, artwork_image_url, marquee_accent,
          listen_apple_url, listen_spotify_url, listen_youtube_url, listen_rss_url
   FROM slates WHERE slug = ?`,
).bind(slug).first<{
  id: string; slug: string; name: string; description: string | null;
  timezone: string; is_public: number;
  cover_image_url: string | null;
  artwork_image_url: string | null;
  marquee_accent: string | null;
  listen_apple_url: string | null;
  listen_spotify_url: string | null;
  listen_youtube_url: string | null;
  listen_rss_url: string | null;
}>();

if (!slate) return new Response('Not found', { status: 404 });
if (!slate.is_public) return new Response('Private slate', { status: 403 });

const user = Astro.locals.user;
const member = user ? await db.prepare(
  `SELECT role, is_admin FROM slate_members WHERE slate_id = ? AND user_id = ?`,
).bind(slate.id, user.id).first<{ role: string; is_admin: number }>() : null;
const isMember = !!member;
const isHost = (member?.role === 'host' || !!member?.is_admin) || isAppAdmin(user?.scopes);
const isAdmin = isAppAdmin(user?.scopes);

const env = getEnv(Astro);
const url = new URL(Astro.request.url);
const signInHref = signInUrl(env, url.origin, `/${slate.slug}`);

// Unread-activity count for the nav badge — only when signed in as a
// member (or App Admin). Doubles as the trigger for the activity icon.
let unreadActivity = 0;
if (user && (isMember || isAdmin)) {
  const watermark = await db.prepare(
    'SELECT watermark_at FROM activity_seen WHERE user_id = ? AND slate_id = ?',
  ).bind(user.id, slate.id).first<{ watermark_at: number }>();
  const wm = watermark?.watermark_at ?? 0;
  const row = await db.prepare(
    'SELECT COUNT(*) AS n FROM activity WHERE slate_id = ? AND created_at > ?',
  ).bind(slate.id, wm).first<{ n: number }>();
  unreadActivity = row?.n ?? 0;
}

// Marquee data — same queries for everyone since this is always public.
// The shows roster lives on its own page (/[slate]/shows) and is linked
// from the nav, so the home page only loads slot-related data here.
const [upcoming, topTopics, totalTopicsRow, pastEpisodes] = await Promise.all([
  db.prepare(
    `SELECT sl.id, sl.start_time, sl.promo_image_url, sl.topic_id, sl.show_id,
            COALESCE(sl.custom_title, sug.title) AS title,
            u.display_name AS host_display_name,
            u.email        AS host_email,
            u.headshot_url AS host_headshot_url,
            sh.slug            AS show_slug,
            sh.name            AS show_name,
            sh.cover_image_url AS show_cover
     FROM slots sl
     LEFT JOIN topics sug ON sug.id = sl.topic_id
     LEFT JOIN users u    ON u.id = sl.host_id
     LEFT JOIN shows sh   ON sh.id = sl.show_id
     WHERE sl.slate_id = ? AND sl.start_time >= unixepoch()
       AND sl.status NOT IN ('cancelled')
     ORDER BY sl.start_time LIMIT 6`,
  ).bind(slate.id).all<{
    id: string; start_time: number; title: string | null;
    topic_id: string | null; show_id: string | null;
    promo_image_url: string | null;
    host_display_name: string | null; host_email: string | null;
    host_headshot_url: string | null;
    show_slug: string | null; show_name: string | null;
    show_cover: string | null;
  }>(),
  // Topic Pool — open AND not already attached to a slot.
  // Comment count via LEFT JOIN on a pre-aggregated subquery so SQLite
  // can use the partial index comments_topic_active (which excludes
  // soft-deleted rows). Cheaper than a correlated subquery per row.
  db.prepare(
    `SELECT s.id, s.title, s.upvote_count, COALESCE(cc.n, 0) AS comment_count
     FROM topics s
     LEFT JOIN (
       SELECT topic_id, COUNT(*) AS n
       FROM comments
       WHERE deleted_at IS NULL
       GROUP BY topic_id
     ) cc ON cc.topic_id = s.id
     WHERE s.slate_id = ? AND s.status = 'open' AND s.scheduled_slot_id IS NULL
     ORDER BY s.upvote_count DESC, s.submitted_at DESC LIMIT 20`,
  ).bind(slate.id).all<{ id: string; title: string; upvote_count: number; comment_count: number }>(),
  // Total open-unscheduled topic count — feeds the "see all (N) →"
  // affordance at the bottom of the topic pool. Same WHERE clause as
  // the LIMIT 20 query above.
  db.prepare(
    `SELECT COUNT(*) AS n FROM topics
     WHERE slate_id = ? AND status = 'open' AND scheduled_slot_id IS NULL`,
  ).bind(slate.id).first<{ n: number }>(),
  db.prepare(
    `SELECT sl.id, sl.start_time,
            COALESCE(sl.custom_title, sug.title) AS title,
            u.display_name AS host_display_name,
            u.email        AS host_email,
            sh.slug AS show_slug,
            sh.name AS show_name
     FROM slots sl
     LEFT JOIN topics sug ON sug.id = sl.topic_id
     LEFT JOIN users u    ON u.id = sl.host_id
     LEFT JOIN shows sh   ON sh.id = sl.show_id
     WHERE sl.slate_id = ? AND sl.start_time < unixepoch()
       AND sl.status IN ('recorded','published')
     ORDER BY sl.start_time DESC LIMIT 12`,
  ).bind(slate.id).all<{
    id: string; start_time: number; title: string | null;
    host_display_name: string | null; host_email: string | null;
    show_slug: string | null; show_name: string | null;
  }>(),
]);
---

<Layout
  title={`${slate.name} · slate.ljs.app`}
  description={slate.description ?? undefined}
  slate={{ name: slate.name, slug: slate.slug, artwork_image_url: slate.artwork_image_url }}
  slateContext={{ isMember, isHost, role: member?.role as 'member' | 'host' | undefined ?? null, unreadActivity }}
>
  <SlateMarquee
    slate={slate}
    upcoming={upcoming.results}
    topTopics={topTopics.results}
    totalTopicCount={totalTopicsRow?.n ?? 0}
    pastEpisodes={pastEpisodes.results}
    signInHref={signInHref}
    isSignedIn={!!user}
    isMember={isMember}
    isHost={isHost}
  />
</Layout>
