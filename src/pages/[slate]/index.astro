---
import Layout from '@/layouts/Layout.astro';
import ScheduleGrid from '@/components/ScheduleGrid';
import ScheduleSuggestionPanel from '@/components/ScheduleSuggestionPanel.astro';
import SuggestionDetailPanel from '@/components/SuggestionDetailPanel.astro';
import SuggestionCard from '@/components/SuggestionCard.astro';
import { getDb, getEnv } from '@/lib/db';
import { isAppAdmin, signInUrl } from '@/lib/auth';

export const prerender = false;

const slug = Astro.params.slate;
if (!slug) return new Response('Not found', { status: 404 });

const db = getDb(Astro);
const slate = await db.prepare(
  `SELECT id, slug, name, description, timezone, is_public FROM slates WHERE slug = ?`,
).bind(slug).first<{ id: string; slug: string; name: string; description: string | null; timezone: string; is_public: number }>();

if (!slate) return new Response('Not found', { status: 404 });
if (!slate.is_public) return new Response('Private slate', { status: 403 });

// Slots window: roughly the next ~3 months from "today" (UTC) — covers
// "current + next month" reliably across timezones, with a buffer for tz drift.
const nowSec = Math.floor(Date.now() / 1000);
const horizonSec = nowSec + 95 * 86400;
const slots = await db.prepare(
  `SELECT sl.id, sl.start_time, sl.duration_minutes, sl.status,
          COALESCE(sl.custom_title, sug.title) AS title,
          u.email AS speaker_email
   FROM slots sl
   LEFT JOIN suggestions sug ON sug.id = sl.suggestion_id
   LEFT JOIN users u ON u.id = sl.speaker_id
   WHERE sl.slate_id = ? AND sl.status != 'cancelled'
   AND sl.start_time >= ? AND sl.start_time < ?
   ORDER BY sl.start_time`,
).bind(slate.id, nowSec - 86400, horizonSec).all<{ id: string; start_time: number; duration_minutes: number; status: string; title: string | null; speaker_email: string | null }>();

const slotsForGrid = slots.results.map(s => ({
  id: s.id,
  start_time: s.start_time,
  duration_minutes: s.duration_minutes,
  status: s.status as any,
  theme: null,
  title: s.title,
}));

const user = Astro.locals.user;
const member = user ? await db.prepare(
  `SELECT role FROM slate_members WHERE slate_id = ? AND user_id = ?`,
).bind(slate.id, user.id).first<{ role: string }>() : null;
const isMember = !!member;
const isSpeaker = member?.role === 'speaker' || isAppAdmin(user?.scopes);

// Full pool of open + scheduled suggestions for the topics pane. Open first
// so a speaker scanning for things to claim sees actionable rows above the
// already-taken ones; within each status, by upvote count then recency.
// Archived suggestions are accessible via the /suggestions archive view.
const suggestions = await db.prepare(
  `SELECT s.id, s.title, s.description, s.url, s.upvote_count, s.status,
          s.scheduled_slot_id,
          sl.start_time AS scheduled_start, sl.duration_minutes AS scheduled_duration,
          sl.speaker_id AS scheduled_speaker_id,
          spk.email AS scheduled_speaker_email,
          spk.display_name AS scheduled_speaker_display_name,
          (SELECT 1 FROM suggestion_votes v WHERE v.suggestion_id = s.id AND v.user_id = ?) AS has_voted
   FROM suggestions s
   LEFT JOIN slots sl ON sl.id = s.scheduled_slot_id
   LEFT JOIN users spk ON spk.id = sl.speaker_id
   WHERE s.slate_id = ? AND s.status IN ('open','scheduled')
   ORDER BY (s.status = 'open') DESC, s.upvote_count DESC, s.submitted_at DESC`,
).bind(user?.id ?? '', slate.id).all<{
  id: string; title: string; description: string | null; url: string | null;
  upvote_count: number; status: string; has_voted: number | null;
  scheduled_slot_id: string | null;
  scheduled_start: number | null; scheduled_duration: number | null;
  scheduled_speaker_id: string | null;
  scheduled_speaker_email: string | null;
  scheduled_speaker_display_name: string | null;
}>();

const openCount = suggestions.results.filter(s => s.status === 'open').length;
const scheduledCount = suggestions.results.filter(s => s.status === 'scheduled').length;
const totalCount = suggestions.results.length;

const fmtSched = new Intl.DateTimeFormat('en-US', {
  timeZone: slate.timezone, weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit',
});

// Unread-activity count for the current user (only when they're a member).
let unreadActivity = 0;
if (user && (isMember || isAppAdmin(user.scopes))) {
  const watermark = await db.prepare(
    'SELECT watermark_at FROM activity_seen WHERE user_id = ? AND slate_id = ?',
  ).bind(user.id, slate.id).first<{ watermark_at: number }>();
  const wm = watermark?.watermark_at ?? 0;
  const row = await db.prepare(
    'SELECT COUNT(*) AS n FROM activity WHERE slate_id = ? AND created_at > ?',
  ).bind(slate.id, wm).first<{ n: number }>();
  unreadActivity = row?.n ?? 0;
}

const env = getEnv(Astro);
const url = new URL(Astro.request.url);
const signInHref = signInUrl(env, url.origin, `/${slate.slug}`);
---

<Layout
  title={`${slate.name} · slate.ljs.app`}
  description={slate.description ?? undefined}
  slate={{ name: slate.name, slug: slate.slug }}
  slateContext={{ isMember, isSpeaker, role: member?.role as 'member' | 'speaker' | undefined ?? null, unreadActivity }}
>
  {/* Mobile-only tab bar — sticky to viewport top so the user can switch
      between Topics and Schedule without scrolling back up. */}
  <div class="lg:hidden sticky top-0 z-20 bg-base-100/95 backdrop-blur border-b border-base-300 -mx-4 mb-4">
    <div class="flex">
      <button data-tab="topics" type="button" class="tab-btn flex-1 py-3 text-sm font-semibold border-b-2 border-signal text-signal">
        Topics <span class="opacity-60 font-normal">({totalCount})</span>
      </button>
      <button data-tab="schedule" type="button" class="tab-btn flex-1 py-3 text-sm font-semibold border-b-2 border-transparent opacity-60">
        Schedule
      </button>
    </div>
  </div>

  {/* Two-pane container: side-by-side on lg, tab-toggled on smaller screens. */}
  <div data-active-tab="topics" class="lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
    {/* TOPICS pane */}
    <section data-panel="topics" aria-label="Topic suggestions">
      <header class="flex items-baseline justify-between gap-3 mb-3 mt-4 lg:mt-0">
        <h2 class="text-lg font-semibold hidden lg:block">Topics <span class="text-sm opacity-50 font-normal ml-1">{totalCount}</span></h2>
        <div class="ml-auto">
          {isMember && (
            <a href={`/${slate.slug}/suggest`} class="btn btn-primary btn-sm">+ Suggest a topic</a>
          )}
          {user && !isMember && (
            <button id="join-btn" class="btn btn-primary btn-sm">Join as Member</button>
          )}
          {!user && (
            <a href={signInHref} class="btn btn-primary btn-sm">Sign in to suggest</a>
          )}
        </div>
      </header>

      {totalCount === 0 ? (
        <div class="rounded border border-base-300 bg-base-200/40 p-6 text-center">
          <p class="text-sm opacity-70">
            No topics yet.
            {isMember
              ? <> <a href={`/${slate.slug}/suggest`} class="link">Be the first →</a></>
              : !user
                ? <> <a href={signInHref} class="link">Sign in</a> to add the first one.</>
                : <> <a href={`/${slate.slug}/join`} class="link">Join as a Member</a> to add the first one.</>}
          </p>
        </div>
      ) : (
        <>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <div class="flex gap-1 text-xs">
              <button data-filter="open" class="filter-chip btn btn-xs btn-primary">Open <span class="opacity-80 ml-1">{openCount}</span></button>
              <button data-filter="scheduled" class="filter-chip btn btn-xs btn-ghost border border-base-300">Scheduled <span class="opacity-60 ml-1">{scheduledCount}</span></button>
              <button data-filter="all" class="filter-chip btn btn-xs btn-ghost border border-base-300">All <span class="opacity-60 ml-1">{totalCount}</span></button>
            </div>
            <input id="topic-search" type="search" placeholder="Search…"
                   class="input input-bordered input-sm flex-1 min-w-0" />
          </div>

          <div id="topics-list" class="space-y-2">
            {suggestions.results.map(s => (
              <SuggestionCard
                s={s}
                isMember={isMember}
                isSpeaker={isSpeaker}
                currentUserId={user?.id}
                isAdmin={isAppAdmin(user?.scopes)}
                fmtSched={fmtSched}
              />
            ))}
          </div>

          <p id="topics-empty" class="hidden mt-6 text-center text-sm opacity-60">
            Nothing matches.
          </p>

          <p class="mt-6 text-xs opacity-60">
            <a href={`/${slate.slug}/suggestions?status=archived`} class="hover:opacity-100">View archived &amp; details →</a>
          </p>
        </>
      )}
    </section>

    {/* SCHEDULE pane — sticky on desktop so it stays in view while the
        topics list scrolls. */}
    <section data-panel="schedule" aria-label="Schedule" class="lg:sticky lg:top-4 lg:self-start mt-4 lg:mt-0">
      <header class="hidden lg:flex items-baseline justify-between mb-3">
        <h2 class="text-lg font-semibold">Schedule</h2>
        <span class="text-xs opacity-60 font-mono">{slate.timezone}</span>
      </header>

      <ScheduleGrid
        client:load
        slots={slotsForGrid}
        timezone={slate.timezone}
        slateSlug={slate.slug}
        view="window"
      />
    </section>
  </div>

  {isSpeaker && <ScheduleSuggestionPanel slate={{ id: slate.id, slug: slate.slug, name: slate.name }} />}

  <SuggestionDetailPanel
    slate={{ id: slate.id, slug: slate.slug, name: slate.name, timezone: slate.timezone }}
    isMember={isMember}
    isSpeaker={isSpeaker}
    isAdmin={isAppAdmin(user?.scopes)}
    currentUserId={user?.id}
  />

  <style is:inline>
    /* Mobile-only: hide the inactive panel based on the container's
       data-active-tab attribute. On lg+ the grid layout puts both side
       by side and these rules don't apply. */
    @media (max-width: 1023px) {
      [data-active-tab="topics"] [data-panel="schedule"] { display: none; }
      [data-active-tab="schedule"] [data-panel="topics"] { display: none; }
    }
  </style>

  <script is:inline define:vars={{
    slateId: slate.id,
    slateTimezone: slate.timezone,
    isSpeaker,
  }}>
    // ─── Helpers ─────────────────────────────────────────────────────────
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    }
    const fmtSched = new Intl.DateTimeFormat('en-US', {
      timeZone: slateTimezone, weekday: 'short', month: 'short', day: 'numeric',
      hour: 'numeric', minute: '2-digit',
    });

    // ─── Tab switching (mobile only) ─────────────────────────────────────
    const paneContainer = document.querySelector('[data-active-tab]');
    const tabButtons = document.querySelectorAll('[data-tab]');
    function setTab(name) {
      if (paneContainer) paneContainer.dataset.activeTab = name;
      tabButtons.forEach(other => {
        const active = other.dataset.tab === name;
        other.classList.toggle('text-signal', active);
        other.classList.toggle('border-signal', active);
        other.classList.toggle('opacity-60', !active);
        other.classList.toggle('border-transparent', !active);
      });
    }
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => setTab(btn.dataset.tab));
    });

    // ─── Filter chips + search ───────────────────────────────────────────
    const filterChips = document.querySelectorAll('.filter-chip');
    const searchInput = document.getElementById('topic-search');
    const topicsList = document.getElementById('topics-list');
    const topicsEmpty = document.getElementById('topics-empty');
    let activeFilter = 'open';

    function applyFilters() {
      if (!topicsList) return;
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      let visible = 0;
      topicsList.querySelectorAll('[data-suggestion-card]').forEach(card => {
        const status = card.dataset.suggestionStatus;
        const matchesFilter = activeFilter === 'all' || activeFilter === status;
        const matchesSearch = !q || (card.textContent || '').toLowerCase().includes(q);
        const show = matchesFilter && matchesSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      topicsEmpty?.classList.toggle('hidden', visible > 0);
    }
    filterChips.forEach(b => {
      b.addEventListener('click', () => {
        activeFilter = b.dataset.filter;
        filterChips.forEach(other => {
          const active = other === b;
          other.classList.toggle('btn-primary', active);
          other.classList.toggle('btn-ghost', !active);
          other.classList.toggle('border', !active);
          other.classList.toggle('border-base-300', !active);
        });
        applyFilters();
      });
    });
    searchInput?.addEventListener('input', applyFilters);

    // Recount filter-chip badges + mobile tab counter from the DOM.
    function refreshCounts() {
      if (!topicsList) return;
      let open = 0, scheduled = 0;
      topicsList.querySelectorAll('[data-suggestion-card]').forEach(c => {
        if (c.dataset.suggestionStatus === 'open') open++;
        else if (c.dataset.suggestionStatus === 'scheduled') scheduled++;
      });
      const total = open + scheduled;
      const setSpan = (sel, txt) => {
        const el = document.querySelector(sel);
        if (el) el.textContent = txt;
      };
      setSpan('[data-filter="open"] span', ` ${open}`);
      setSpan('[data-filter="scheduled"] span', ` ${scheduled}`);
      setSpan('[data-filter="all"] span', ` ${total}`);
      setSpan('[data-tab="topics"] span', `(${total})`);
    }

    applyFilters();

    // ─── Card transitions (driven by panel / unschedule events) ──────────
    function transitionCardToScheduled(detail) {
      const { suggestionId, slotId, startTime, speakerEmail, speakerName } = detail;
      const card = document.querySelector(`[data-suggestion-card="${suggestionId}"]`);
      if (!card) return;

      card.dataset.suggestionStatus = 'scheduled';
      card.classList.remove('bg-base-100');
      card.classList.add('bg-base-200/40');

      card.querySelector('[data-card-title]')?.classList.add('opacity-70');

      const content = card.querySelector('[data-card-content]');
      if (!content) return;

      let meta = content.querySelector('[data-card-meta]');
      if (!meta) {
        meta = document.createElement('div');
        meta.setAttribute('data-card-meta', '');
        meta.className = 'flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-xs font-mono opacity-60';
        const desc = content.querySelector('[data-card-description]');
        const title = content.querySelector('[data-card-title]');
        (desc ?? title)?.after(meta);
      }
      const dateStr = startTime ? fmtSched.format(new Date(startTime * 1000)) : '';
      const speakerLabel = speakerName || (speakerEmail ? speakerEmail.split('@')[0] : '');
      meta.innerHTML =
        (dateStr ? `<span>${escapeHtml(dateStr)}</span>` : '') +
        (speakerLabel ? `<span class="opacity-80">→ ${escapeHtml(speakerLabel)}</span>` : '');

      let actions = content.querySelector('[data-card-actions]');
      if (!actions) {
        actions = document.createElement('div');
        actions.setAttribute('data-card-actions', '');
        actions.className = 'mt-3 flex items-center gap-3';
        content.appendChild(actions);
      }
      const titleText = card.dataset.suggestionTitle ?? '';
      actions.innerHTML = `
        <button type="button"
                class="unschedule-trigger text-xs opacity-60 hover:opacity-100 hover:text-error transition-colors px-2 py-1 -mx-2"
                data-slot-id="${escapeHtml(slotId)}"
                data-suggestion-title="${escapeHtml(titleText)}">
          Unschedule
        </button>
      `;
      bindUnscheduleTriggers(actions);

      applyFilters();
      refreshCounts();
    }

    function transitionCardToOpen(detail) {
      const { suggestionId } = detail;
      const card = document.querySelector(`[data-suggestion-card="${suggestionId}"]`);
      if (!card) return;

      card.dataset.suggestionStatus = 'open';
      card.classList.remove('bg-base-200/40');
      card.classList.add('bg-base-100');

      card.querySelector('[data-card-title]')?.classList.remove('opacity-70');

      const content = card.querySelector('[data-card-content]');
      if (!content) return;

      content.querySelector('[data-card-meta]')?.remove();

      let actions = content.querySelector('[data-card-actions]');
      if (isSpeaker) {
        if (!actions) {
          actions = document.createElement('div');
          actions.setAttribute('data-card-actions', '');
          actions.className = 'mt-3 flex items-center gap-3';
          content.appendChild(actions);
        }
        const titleText = card.dataset.suggestionTitle ?? '';
        actions.innerHTML = `
          <button type="button"
                  class="schedule-trigger btn btn-sm btn-primary"
                  data-suggestion-id="${escapeHtml(suggestionId)}"
                  data-suggestion-title="${escapeHtml(titleText)}">
            Claim &amp; schedule
          </button>
        `;
        bindScheduleTriggers(actions);
      } else {
        actions?.remove();
      }

      applyFilters();
      refreshCounts();
    }

    window.addEventListener('suggestion-scheduled', (e) => transitionCardToScheduled(e.detail ?? {}));
    window.addEventListener('suggestion-unscheduled', (e) => transitionCardToOpen(e.detail ?? {}));

    // ─── Join, upvote, schedule, unschedule ──────────────────────────────
    const joinBtn = document.getElementById('join-btn');
    joinBtn?.addEventListener('click', async () => {
      joinBtn.disabled = true;
      const res = await fetch(`/api/slates/${slateId}/join`, { method: 'POST' });
      if (res.ok) location.reload();
      else { joinBtn.disabled = false; alert((await res.json().catch(() => ({}))).error ?? res.status); }
    });

    function bindUpvote(root) {
      root.querySelectorAll('.upvote').forEach(b => {
        if (b.dataset.bound) return;
        b.dataset.bound = '1';
        b.addEventListener('click', async (e) => {
          e.stopPropagation();
          b.disabled = true;
          const res = await fetch(`/api/suggestions/${b.dataset.id}/vote`, { method: 'POST' });
          if (res.ok) {
            const body = await res.json();
            const voted = !!body.has_voted;
            const arrow = b.querySelector('[data-vote-arrow]');
            const count = b.querySelector('[data-vote-count]');
            arrow.classList.toggle('text-signal', voted);
            arrow.classList.toggle('opacity-40', !voted);
            count.classList.toggle('text-signal', voted);
            count.classList.toggle('font-bold', voted);
            count.classList.toggle('opacity-70', !voted);
            count.textContent = body.upvote_count;
            const card = b.closest('[data-suggestion-card]');
            card?.classList.toggle('border-signal', voted);
            card?.classList.toggle('border-base-300', !voted);
          } else {
            alert((await res.json().catch(() => ({}))).error ?? res.status);
          }
          b.disabled = false;
        });
      });
    }
    function bindScheduleTriggers(root) {
      root.querySelectorAll('.schedule-trigger').forEach(b => {
        if (b.dataset.bound) return;
        b.dataset.bound = '1';
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('schedule-suggestion', {
            detail: {
              suggestionId: b.dataset.suggestionId,
              suggestionTitle: b.dataset.suggestionTitle,
            },
          }));
        });
      });
    }
    function bindUnscheduleTriggers(root) {
      root.querySelectorAll('.unschedule-trigger').forEach(b => {
        if (b.dataset.bound) return;
        b.dataset.bound = '1';
        b.addEventListener('click', async (e) => {
          e.stopPropagation();
          if (!confirm(`Unschedule "${b.dataset.suggestionTitle}"? The slot goes back to open.`)) return;
          b.disabled = true;
          const slotId = b.dataset.slotId;
          const res = await fetch(`/api/slots/${slotId}/claim-and-schedule`, { method: 'DELETE' });
          if (res.ok) {
            const body = await res.json();
            // Calendar: slot goes back to open, lose the title hint
            window.dispatchEvent(new CustomEvent('slot-updated', {
              detail: { slotId, status: 'open', title: null },
            }));
            // Topic pane: card flips back to open
            if (body.freed_suggestion_id) {
              window.dispatchEvent(new CustomEvent('suggestion-unscheduled', {
                detail: { suggestionId: body.freed_suggestion_id },
              }));
            }
          } else {
            b.disabled = false;
            alert((await res.json().catch(() => ({}))).error ?? res.status);
          }
        });
      });
    }
    bindUpvote(document);
    bindScheduleTriggers(document);
    bindUnscheduleTriggers(document);

    // ─── Open detail panel on card click (anywhere not a button/link) ────
    function openDetail(card) {
      window.dispatchEvent(new CustomEvent('view-suggestion', {
        detail: { suggestionId: card.dataset.suggestionCard },
      }));
    }
    function bindCardClick(root) {
      root.querySelectorAll('[data-suggestion-card]').forEach(card => {
        if (card.dataset.cardBound) return;
        card.dataset.cardBound = '1';
        card.addEventListener('click', (e) => {
          // Ignore clicks on interactive descendants — they handle themselves.
          if (e.target.closest('button, a')) return;
          openDetail(card);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target !== card) return; // child controls have their own keying
          e.preventDefault();
          openDetail(card);
        });
      });
    }
    bindCardClick(document);
  </script>
</Layout>
